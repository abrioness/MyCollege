@model WebColegio.Models.ViewModel.RestablecerPasswordViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva contraseña - Colegio San Francisco Javier</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <section class="login-form-panel" style="max-width: none; flex: 1;">
            <div class="login-wrapper">
                <div class="login_container">
                    <div class="right">
                        <div class="center text-white text-center">
                            <div class="login">Nueva contraseña</div>
                            <img src="~/Image/colegiosanfrancisco.png" class="logo" alt="Emblema del colegio" />
                        </div>
                        <form class="form" method="post" asp-action="RestablecerPassword">
                            <input type="hidden" asp-for="Token" />
                            <label asp-for="NuevaPassword"></label>
                            <input asp-for="NuevaPassword" autocomplete="new-password" />
                            <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                            <label asp-for="ConfirmarPassword"></label>
                            <input asp-for="ConfirmarPassword" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                            <input type="submit" id="submit" value="Guardar contraseña" />
                            <div class="login-back">
                                <a asp-controller="Login" asp-action="Login">Volver al inicio de sesión</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
                Swal.fire({
                    title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
             TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
             "Información")',
                    text: mensaje,
                    icon: '@TempData["Tipo"]',
                    confirmButtonText: 'Aceptar'
                });
            });
        </script>
    }
</body>
</html>
