@model WebColegio.Models.ViewModel.UsuarioViewModel

@{
    Layout = null;
    var slidesInicio = new[]
    {
        new { Img = "fondoInicio.jpg", Titulo = "Colegio Parroquial San Francisco Javier", Subtitulo = "En todo amar y servir" },
        new { Img = "fondoInicio1.jpg", Titulo = "Formación integral", Subtitulo = "Educación con valores cristianos" },
        new { Img = "fondoInicio.png", Titulo = "Bienvenidos", Subtitulo = "Sistema de gestión escolar" }
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inicio - Colegio San Francisco Javier</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <section class="login-carousel-panel" aria-label="Galería del colegio">
            <div id="carouselInicio" class="carousel slide carousel-fade h-100" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover">
                <div class="carousel-indicators">
                    @for (int i = 0; i < slidesInicio.Length; i++)
                    {
                        <button type="button" data-bs-target="#carouselInicio" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Diapositiva @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner h-100">
                    @for (int i = 0; i < slidesInicio.Length; i++)
                    {
                        var slide = slidesInicio[i];
                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                            <img src="~/Image/@slide.Img" class="d-block w-100 h-100 login-carousel-img" alt="@slide.Titulo" asp-append-version="true" />
                            <div class="carousel-caption login-carousel-caption">
                                <h2 class="login-carousel-title">@slide.Titulo</h2>
                                <p class="login-carousel-subtitle mb-0">@slide.Subtitulo</p>
                            </div>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselInicio" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselInicio" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
            <div class="login-carousel-overlay"></div>
        </section>

        <section class="login-form-panel">
            <div class="login-wrapper">
                <div class="login_container">
                    <div class="right">
                        <div class="center text-white text-center">
                            <div class="login">Iniciar Sesión</div>
                            <img src="~/Image/colegiosanfrancisco.png" class="logo" alt="Emblema del colegio" />
                        </div>
                        <form class="form" method="post" asp-action="Login" enctype="multipart/form-data">
                            <label for="user">Usuario</label>
                            <input type="text" name="NombreUsuario" id="user" required placeholder="Nombre de usuario" autocomplete="username" />
                            <label for="password">Contraseña</label>
                            <input type="password" name="Password" id="password" required placeholder="Contraseña" autocomplete="current-password" />
                            <input type="submit" id="submit" value="Iniciar Sesión" />
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
                Swal.fire({
                    title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
         TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
         "Información")',
                    text: mensaje,
                    icon: '@TempData["Tipo"]',
                    confirmButtonText: 'Aceptar'
                });
            });
        </script>
    }
</body>
</html>
