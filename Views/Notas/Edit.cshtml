@model WebColegio.Models.ViewModel.NotasViewModel

@* @{
    ViewData["Title"] = "Edit";
} *@




<div class="container mt-6" style="padding:50px;">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-plus"></i> Actualizar Registro de Nota</h4>
        </div>
        <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-lg-4">
            <div class="form-group">

                <input type="hidden" asp-for="notas.IdNota" class="form-control" />

            </div>
                <div class="form-group">
                    <label asp-for="notas.IdAlumno" class="control-label">Nombre del Alumno</label>
                                <select asp-for="notas.IdAlumno" id="NombreAlumno" asp-items="Model.alumnosSelectListItem" class="form-select" required>
                                    <option disabled selected>Seleccione el Alumno</option>
                                </select>
                    
                </div>
                        <div class="form-group">
                            <label asp-for="notas.IdModalidad" class="control-label">Modalidad</label>

                            <select asp-for="notas.IdModalidad" asp-items="Model.modalidadSelectListItem" class="form-select" required>
                                <option disabled selected>Seleccione la Modalidad</option>
                            </select>
                            <span asp-validation-for="notas.IdModalidad" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.IdGrado" class="control-label">Nivel</label>
                            <select asp-for="notas.IdGrado" asp-items="Model.gradosSelectListItem" class="form-select" required>
                                <option disabled selected>Seleccione el Nivel</option>
                            </select>
                            <span asp-validation-for="notas.IdGrado" class="text-danger"></span>

                        </div>
                        <div class="form-group">
                            <label asp-for="notas.IdColegio" class="control-label">Recinto (colegio)</label>
                            <select asp-for="notas.IdColegio" asp-items="Model.recintosSelectListItem" class="form-select">
                                <option value="">Seleccione el recinto…</option>
                            </select>
                            <span asp-validation-for="notas.IdColegio" class="text-danger"></span>
                        </div>
                <div class="form-group">
                    <label asp-for="notas.IdAsignatura" class="control-label">Asignatura</label>
                    <select asp-for="notas.IdAsignatura" asp-items="Model.asignaturaSelectListItem" class="form-select" required>
                        <option disabled selected>Seleccione la Asignatura</option>
                    </select>
                    <span asp-validation-for="notas.IdAsignatura" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="notas.Descripcion" class="control-label">Observación</label>
                    <textarea asp-for="notas.Descripcion" class="form-control"> </textarea>
                    @* <span asp-validation-for="Descripcion" class="text-danger"></span> *@
                </div>
        </div>
                    <div class="col-lg-4">
                        <p class="text-muted small mb-2"><strong>Escala cualitativa:</strong> AA (100-90), AS (89-76), AF (75-60), AI (59-0). En 3.° a 11.°: AI = Aprendizaje inicial (59-0).</p>
                        <div class="form-group">
                            <label asp-for="notas.PrimerCorteCualitativo" class="control-label">Primer Corte (cualitativo)</label>
                            <select asp-for="notas.PrimerCorteCualitativo" asp-items="Model.NotasCualitativasSelectListItem" class="form-select">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.SegundoCorteCualitativo" class="control-label">Segundo Corte (cualitativo)</label>
                            <select asp-for="notas.SegundoCorteCualitativo" asp-items="Model.NotasCualitativasSelectListItem" class="form-select">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.TercerCorteCualitativo" class="control-label">Tercer Corte (cualitativo)</label>
                            <select asp-for="notas.TercerCorteCualitativo" asp-items="Model.NotasCualitativasSelectListItem" class="form-select">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.CuartoCorteCualitativo" class="control-label">Cuarto Corte (cualitativo)</label>
                            <select asp-for="notas.CuartoCorteCualitativo" asp-items="Model.NotasCualitativasSelectListItem" class="form-select">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.NotaFinalCualitativo" class="control-label">Nota Final (cualitativa)</label>
                            <select asp-for="notas.NotaFinalCualitativo" asp-items="Model.NotasCualitativasSelectListItem" class="form-select">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <p class="text-muted small mb-2">Opcional: valores numéricos (acumulado + examen); equivalencia cualitativa según escala 90-100 = AA, etc.</p>
                        <div class="form-group">
                            <label asp-for="notas.Acumulado1" class="control-label">Acumulado 1</label>
                            <input asp-for="notas.Acumulado1" id="acumulado1" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Examen1" class="control-label">Examen 1</label>
                            <input asp-for="notas.Examen1" id="examen1" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.PrimerCorteCuantitativo" class="control-label">Primer Corte</label>
                            <input asp-for="notas.PrimerCorteCuantitativo" id="primerCorte" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Acumulado2" class="control-label">Acumulado 2</label>
                            <input asp-for="notas.Acumulado2" id="acumulado2" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Examen2" class="control-label">Examen 2</label>
                            <input asp-for="notas.Examen2" id="examen2" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.SegundoCorteCuantitativo" class="control-label">Segundo Corte</label>
                            <input asp-for="notas.SegundoCorteCuantitativo" id="segundoCorte" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label asp-for="notas.Acumulado3" class="control-label">Acumulado 3</label>
                            <input asp-for="notas.Acumulado3" id="acumulado3" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Examen3" class="control-label">Examen 3</label>
                            <input asp-for="notas.Examen3" id="examen3" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.TercerCorteCuantitativo" class="control-label">Tercer Corte</label>
                            <input asp-for="notas.TercerCorteCuantitativo" id="tercerCorte" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Acumulado4" class="control-label">Acumulado 4</label>
                            <input asp-for="notas.Acumulado4" id="acumulado4" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.Examen4" class="control-label">Examen 4</label>
                            <input asp-for="notas.Examen4" id="examen4" class="form-control" type="number" min="0" max="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.CuartoCorteCuantitativo" class="control-label">Cuarto Corte</label>
                            <input asp-for="notas.CuartoCorteCuantitativo" id="cuartoCorte" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label asp-for="notas.NotaFinalCuantitativo" class="control-label">Nota Final</label>
                            <input asp-for="notas.NotaFinalCuantitativo" id="notaFinal" class="form-control" readonly step="0.01" />
                        </div>
            <br />
        </div>
    </div>
    <br />
    <!-- Botones -->
    <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
                    <button type="button" id="btnLimpiar" class="btn btn-warning">
                        <i class="bi bi-trash3"></i> Limpiar Campos
                    </button>
    </div>
        </form>
    </div>
</div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
	<script src="~/js/limpiarcampos.js"></script>
<script>
    $(document).ready(function () {
        // Deshabilitar campos si ya tienen valor
        // if ($("#primerCorte").val() && $("#primerCorte").val() !== "0") {
        //     $("#primerCorte").prop("disabled", true);
        // }
        // if ($("#segundoCorte").val() && $("#segundoCorte").val() !== "0") {
        //     $("#segundoCorte").prop("disabled", true);
        // }
        // if ($("#tercerCorte").val() && $("#tercerCorte").val() !== "0") {
        //     $("#tercerCorte").prop("disabled", true);
        // }
        // if ($("#cuartoCorte").val() && $("#cuartoCorte").val() !== "0") {
        //     $("#cuartoCorte").prop("disabled", true);
        // }

        // Nombre del alumno siempre deshabilitado
        $("#NombreAlumno").prop("disabled", true);

        function numeroACualitativo(n) {
            if (n == null || isNaN(n)) return "";
            if (n >= 90) return "AA";
            if (n >= 76) return "AS";
            if (n >= 60) return "AF";
            return "AI";
        }
        function calcularNotaFinal() {
            var acu1 = parseFloat($("#acumulado1").val()) || 0, acu2 = parseFloat($("#acumulado2").val()) || 0;
            var acu3 = parseFloat($("#acumulado3").val()) || 0, acu4 = parseFloat($("#acumulado4").val()) || 0;
            var exam1 = parseFloat($("#examen1").val()) || 0, exam2 = parseFloat($("#examen2").val()) || 0;
            var exam3 = parseFloat($("#examen3").val()) || 0, exam4 = parseFloat($("#examen4").val()) || 0;
            var pc1 = acu1 + exam1, pc2 = acu2 + exam2, pc3 = acu3 + exam3, pc4 = acu4 + exam4;
            $("#primerCorte").val(pc1.toFixed(1));
            $("#segundoCorte").val(pc2.toFixed(1));
            $("#tercerCorte").val(pc3.toFixed(1));
            $("#cuartoCorte").val(pc4.toFixed(1));
            var nf = (pc1 + pc2 + pc3 + pc4) / 4;
            $("#notaFinal").val(nf.toFixed(2));
            if (nf && !$("#notas_NotaFinalCualitativa").val()) $("#notas_NotaFinalCualitativa").val(numeroACualitativo(nf));
        }
        $("#acumulado1, #examen1, #acumulado2, #examen2, #acumulado3, #examen3, #acumulado4, #examen4").on("input", calcularNotaFinal);
        calcularNotaFinal();
    });
</script>
}


 

