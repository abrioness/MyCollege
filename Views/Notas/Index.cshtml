@model WebColegio.Models.ViewModel.ColeccionCatalogos
@using System.Linq
<script src="~/js/site.js"></script>
<div class="container mt-auto" style="padding:2px;">
<div class="card shadow-lg p-3 mb-5 bg-white rounded">
	<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi-pencil-square"></i> Reporte de Notas</h5>
	</div>
	<div class="card-body">
		@if (TempData["Mensaje"] != null)
		{
			<div class="alert alert-@(TempData["Tipo"]?.ToString() == "success" ? "success" : TempData["Tipo"]?.ToString() == "warning" ? "warning" : "danger") alert-dismissible fade show" role="alert">
				@TempData["Mensaje"]
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
			</div>
		}
		<div class="table-responsive" style="font-size:11px">
				<div class="col-lg-8 mb-3">
					@using (Html.BeginForm("Index", "Notas", FormMethod.Get))
					{
						<div class="row g-2 align-items-end">
							<div class="col-auto">
								<label class="control-label">Desde:</label>
								<input type="date" name="fechainicio" id="FechaInicio" class="form-control form-control-sm"
									   value="@Context.Request.Query["fechainicio"]" />
							</div>
							<div class="col-auto">
								<label class="control-label">Hasta:</label>
								<input type="date" name="fechafin" id="FechaFin" class="form-control form-control-sm"
									   value="@Context.Request.Query["fechafin"]" />
							</div>
							<div class="col-auto">
								<button type="submit" class="btn btn-success btn-sm">Filtrar</button>
							</div>
						</div>
					}
				</div>
			<div class="col-12 text-end mb-2">
				<a asp-action="Create" class="btn btn-primary btn-sm">
					<i class="bi bi-plus-circle"></i> Agregar Notas
				</a>
			</div>
			<p class="small text-muted">Formato libreta: cada corte y semestre muestra <strong>CUAL.</strong> y <strong>CUANT.</strong> En preescolar y 1.°–2.° grado la columna CUANT. queda en blanco. Promedios de semestre se calculan a partir de los dos cortes del semestre.</p>

				<table id="tablaNotas" class="table table-bordered table-sm align-middle">
			@await Html.PartialAsync("_NotasLibretaThead", true)
			<tbody>
				@if (Model.notas == null || !Model.notas.Any())
				{
					<tr>
						<td colspan="20" class="text-center text-muted py-4">No hay notas registradas o la API no devolvió datos.</td>
					</tr>
				}
				else
				{
				@foreach (var itemNotas in Model.notas)
				{
					var alumno = Model.alumno?.FirstOrDefault(a => a.IdAlumno == itemNotas.IdAlumno);
					var modalidad = Model.modalidades?.FirstOrDefault(m => m.IdModalidad == itemNotas.IdModalidad);
					var nivel = Model.grados?.FirstOrDefault(g => g.IdGrado == itemNotas.IdGrado);
					var asignatura = Model.asignaturas?.FirstOrDefault(a => a.IdAsignatura == itemNotas.IdAsignatura);
					var soloCual = NotasDisplayHelper.EsSoloCualitativo(modalidad?.Modalidad, nivel?.NombreGrado);
					<tr>
						<td class="text-nowrap">
							<a asp-action="Edit" asp-controller="Notas" asp-route-id="@itemNotas.IdNota" class="btn btn-sm btn-info py-0">@(alumno != null ? $"{alumno.Nombre} {alumno.Apellido}" : $"#{itemNotas.IdAlumno}")</a>
						</td>
						<td>@(modalidad?.Modalidad ?? "—")</td>
						<td>@(nivel?.NombreGrado ?? "—")</td>
						<td>@(asignatura?.NombreAsignatura ?? "—")</td>
						@await Html.PartialAsync("_NotasLibretaCeldasCalificaciones", new NotasLibretaCeldaModel { Nota = itemNotas, SoloCualitativo = soloCual })
						<td>@itemNotas.FechaRegistro.ToString("dd/MM/yyyy")</td>
						<td>
							<a asp-action="Details" asp-controller="Notas" asp-route-id="@itemNotas.IdAlumno" class="btn btn-sm btn-warning py-0" title="Ver detalle"><i class="bi bi-journal-richtext"></i></a>
						</td>
					</tr>
				}
				}
			</tbody>
		</table>
	</div>
		</div>
</div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script>
	$(document).ready(function () {
		var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");
		var botones = esCajero ? [] : [{ extend: 'excelHtml5', text: 'Exportar a Excel', className: 'btn btn-success btn-sm' }];
		if ($('#tablaNotas tbody tr').length && !$('#tablaNotas tbody td[colspan]').length) {
			$('#tablaNotas').DataTable({
				responsive: false,
				scrollX: true,
				dom: esCajero ? 'frtip' : 'Bfrtip',
				buttons: botones,
				ordering: false,
				language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" }
			});
		}
	});
</script>
