@model WebColegio.Models.ViewModel.NotasViewModel
@using System.Linq

<script src="~/js/site.js"></script>
@{
    var modAlumno = Model.modalidadSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdModalidad?.ToString())?.Text;
    var gradoAlumno = Model.gradosSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdGrado?.ToString())?.Text;
    var soloCualDetalle = NotasDisplayHelper.EsSoloCualitativo(modAlumno, gradoAlumno);
}
<div class="card shadow-lg p-3 mb-5 bg-white rounded">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-mortarboard-fill"></i> Detalles de notas (libreta)</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-6">
                <h2>@Model.alumnoNotas.Nombre @Model.alumnoNotas.Apellido</h2>
                <b>Dirección:</b> <span>@Model.alumnoNotas.Direccion</span><br />
                <b>Período lectivo:</b> <span>@(!string.IsNullOrEmpty(Model.PeriodoLectivoActualTexto) ? Model.PeriodoLectivoActualTexto : Model.periodoSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdPeriodo?.ToString())?.Text)</span>
                @if (!string.IsNullOrEmpty(Model.PeriodoLectivoActualTexto) && Model.alumnoNotas.IdPeriodo.HasValue && Model.periodoSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdPeriodo?.ToString())?.Text != Model.PeriodoLectivoActualTexto)
                {<span class="small text-muted"> (en ficha: @Model.periodoSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdPeriodo?.ToString())?.Text)</span>}<br />
                <b>Modalidad:</b> <span>@modAlumno</span><br />
                <b>Nivel:</b> <span>@gradoAlumno</span><br />
                <b>Sexo:</b> <span>@Model.sexoSelectListItem.FirstOrDefault(a => a.Value == Model.alumnoNotas.IdSexo.ToString())?.Text</span>
            </div>
        </div>
        @if (soloCualDetalle)
        {
            <p class="small text-muted mt-2">Solo cualitativo (preescolar o 1.°–2.°): columna <strong>CUANT.</strong> en blanco.</p>
        }
        <br />
        <div class="table-responsive" style="font-size: 11px;">
        <table id="detalleNotas" class="table table-bordered table-sm align-middle">
            @await Html.PartialAsync("_NotasLibretaThead", false)
            <tbody>
                @foreach (var nota in Model.listNotas)
                {
                    <tr>
                        <td>
                            @Model.asignaturaSelectListItem.FirstOrDefault(a => a.Value == nota.IdAsignatura.ToString())?.Text
                        </td>
                        @await Html.PartialAsync("_NotasLibretaCeldasCalificaciones", new NotasLibretaCeldaModel { Nota = nota, SoloCualitativo = soloCualDetalle })
                    </tr>
                }
                @if (!Model.listNotas.Any())
                {
                    <tr><td colspan="15" class="text-center text-muted">No hay registros de notas.</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        if ($('#detalleNotas tbody tr').length && $('#detalleNotas tbody tr td[colspan]').length === 0) {
            $('#detalleNotas').DataTable({ scrollX: true, ordering: false, language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" } });
        }
    });
</script>
