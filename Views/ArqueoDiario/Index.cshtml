@model WebColegio.Models.ViewModel.ArqueoDiarioIndexViewModel
@{
	ViewData["Title"] = "Reporte de Arqueos Diarios";
}
<div class="container-fluid p-1" style="margin:auto;">
	<div class="card shadow-lg p-3 mb-5 bg-white rounded" style="padding-top:50px;">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi bi-cash-stack"></i> Reporte de Arqueos Diarios</h5>
		</div>
		<div class="card-body">
			<div class="table-responsive" style="font-size:12px">
				@using (Html.BeginForm("Index", "ArqueoDiario", FormMethod.Get))
				{
					<div class="row g-2 align-items-end mb-3">
						<div class="col-md-2">
							<label class="form-label">Desde</label>
							<input type="date" name="fechainicio" class="form-control form-control-sm"
								   value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
						</div>
						<div class="col-md-2">
							<label class="form-label">Hasta</label>
							<input type="date" name="fechafin" class="form-control form-control-sm"
								   value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
						</div>
						@if (Model.PuedeElegirRecinto)
						{
							<div class="col-md-3">
								<label class="form-label">Recinto</label>
								<select name="idRecinto" class="form-select form-select-sm">
									<option value="">-- Todos --</option>
									@foreach (var r in Model.Recintos)
									{
										@if (Model.IdRecintoFilter == r.IdRecinto)
										{
											<option value="@r.IdRecinto" selected>@r.Recinto</option>
										}
										else
										{
											<option value="@r.IdRecinto">@r.Recinto</option>
										}
									}
								</select>
							</div>
						}
						else if (Model.Recintos.Count == 1)
						{
							<div class="col-md-3">
								<label class="form-label">Recinto</label>
								<input class="form-control form-control-sm" value="@Model.Recintos[0].Recinto" readonly />
							</div>
						}
						<div class="col-md-2">
							<button type="submit" class="btn btn-success btn-sm w-100">
								<i class="bi bi-funnel"></i> Filtrar
							</button>
						</div>
						<div class="col-md-2">
							<a asp-controller="ArqueoDiario" asp-action="ArqueoCaja" asp-route-fecha="@DateTime.Now.ToString("yyyy-MM-dd")" class="btn btn-primary btn-sm w-100" target="_blank">
								<i class="bi bi-plus-circle"></i> Nuevo Arqueo
							</a>
						</div>
					</div>
				}
				<table id="tablaArqueos" class="table table-bordered table-sm">
					<thead>
						<tr>
							<th>Nº Arqueo</th>
							<th>Serie</th>
							<th>Fecha Registro</th>
							<th>Recinto</th>
							<th>Total Ingreso</th>
							<th>Total Egreso</th>
							<th>Total Efectivo</th>
							<th>Acción</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model.ListaArqueos)
						{
							var recinto = Model.Recintos.FirstOrDefault(r => r.IdRecinto == item.IdRecinto);
							var totalEfectivo = (item.TotalIngreso ?? 0) - (item.TotalEgreso ?? 0);
							<tr>
								<td>@item.NumeroArqueo</td>
								<td>@(item.Serie ?? "A")</td>
								<td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
								<td>@(recinto?.Recinto ?? "N/A")</td>
								<td class="text-end">@((item.TotalIngreso ?? 0).ToString("C"))</td>
								<td class="text-end">@((item.TotalEgreso ?? 0).ToString("C"))</td>
								<td class="text-end">@totalEfectivo.ToString("C")</td>
								<td>
									<a asp-controller="ArqueoDiario" asp-action="ArqueoCaja"
									   asp-route-fecha="@item.FechaRegistro.ToString("yyyy-MM-dd")"
									   asp-route-idRecinto="@(item.IdRecinto ?? 0)"
									   class="btn btn-sm btn-info" target="_blank" title="Ver arqueo">
										<i class="bi bi-eye"></i> Ver
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
				@if (!Model.ListaArqueos.Any())
				{
					<p class="text-muted mb-0">No hay arqueos que coincidan con el filtro.</p>
				}
			</div>
		</div>
	</div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script>
	$(document).ready(function () {
		if ($('#tablaArqueos tbody tr').length > 0) {
			$('#tablaArqueos').DataTable({
				responsive: false,
				order: [[2, 'desc']],
				language: {
					url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
				},
				pageLength: 25
			});
		}
	});
</script>
