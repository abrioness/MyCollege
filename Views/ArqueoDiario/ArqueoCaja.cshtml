@model WebColegio.Models.ViewModel.ArqueoDiarioViewModel
@using System.Globalization

@{
    Layout = null; // Para que se imprima sin master page
    var cultInv = CultureInfo.InvariantCulture;
    var requiereRecintoAdmin = Model.EsAdministrador && Model.TblRecintos != null && Model.TblRecintos.Any(r => r.Activo);
}

<html>
<head>
    <link href="~/css/denominacionesarqueo.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="seleccion-recinto no-print" style="margin: 1rem 0; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px;">
        @if (Model.EsAdministrador)
        {
            <p style="margin: 0 0 0.5rem 0;"><strong>Recinto a arquear:</strong></p>
            @if (Model.TblRecintos != null && Model.TblRecintos.Any())
            {
                <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
                    @foreach (var rec in Model.TblRecintos.Where(r => r.Activo))
                    {
                        <label style="display: inline-flex; align-items: center; cursor: pointer;">
                            <input type="checkbox" class="recinto-checkbox" value="@rec.IdRecinto"
                            @(Model.arqueoDiario?.IdRecinto == rec.IdRecinto ? "checked" : "") />
                            <span style="margin-left: 0.35rem;">@rec.Recinto</span>
                        </label>
                    }
                </div>
                var tieneRecinto = Model.arqueoDiario?.IdRecinto != null && Model.arqueoDiario.IdRecinto > 0;
                if (!tieneRecinto)
                {
                    var urlBase = Url.Action("ArqueoCaja", "ArqueoDiario", new { fecha = Model.Fecha.ToString("yyyy-MM-dd") });
                    <p style="margin: 0.5rem 0 0 0; color: #666;">Seleccione un recinto y pulse el botón para generar el arqueo.</p>
                    <button type="button" class="btn btn-sm btn-primary" id="btnGenerarArqueoRecinto" style="margin-top: 0.5rem;">Generar arqueo del recinto seleccionado</button>
                    <script>
                        document.getElementById("btnGenerarArqueoRecinto").addEventListener("click", function () {
                            var checked = document.querySelector(".recinto-checkbox:checked");
                            if (!checked) { alert("Seleccione un recinto."); return; }
                            var url = "@urlBase" + "&idRecinto=" + checked.value;
                            window.location.href = url;
                        });
                    </script>
                }
            }
            else
            {
                <p style="margin: 0; color: #666;">No hay recintos disponibles.</p>
            }
        }
        else
        {
            <p style="margin: 0;"><strong>Recinto:</strong> @(Model.Colegio ?? "N/A")</p>
            <p style="margin: 0.25rem 0 0 0; color: #666; font-size: 0.9rem;">Arqueo correspondiente a su centro de trabajo.</p>
        }
    </div>
    <form method="post" asp-action="Create" enctype="multipart/form-data" id="formArqueo">
        <input type="hidden" asp-for="Fecha" />
        <div class="titulo">
            @* <h3>@Model.Colegio</h3> *@
            <div class="subtitulo">
                <p>ARQUEO DE CAJA</p>
                <p>@Model.Colegio</p>
                <p>VICARIA DE EDUCACIÓN CATÓLICA</p>
                <p>@Model.Direccion</p>
                <p>Serie: "A" &nbsp;&nbsp; Nº: @Model.siguienteNumero</p>
                @{
                    var fecha = DateTime.Now.ToString("dd/MM/yyyy");
                }
                <p>Fecha: @fecha</p>
                <input type="hidden" asp-for="@Model.arqueoDiario.Serie" value="A" />
                <input type="hidden" asp-for="@Model.arqueoDiario.NumeroArqueo" value="@Model.siguienteNumero" />
                <input type="hidden" asp-for="@Model.arqueoDiario.IdRecinto" id="IdRecintoHidden" value="@(Model.arqueoDiario?.IdRecinto ?? 0)" />
            </div>
        </div>

        <!-- Selección de recinto a arquear -->
       

        <!-- Ingresos -->
        <h4>Ingresos</h4>
        <table>
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th>No. Recibo</th>
                    <th>Cantidad</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Ingresos)
                {
                    <tr>
                        <td>@i.Concepto</td>
                        <td>@i.Recibo</td>
                        <td style="text-align:center">@i.Cantidad</td> 
                        <td style="text-align:right">@i.Monto.ToString("C")</td>
                    </tr>
                }
                @foreach (var i in Model.IngresoCajaDto)
                {
                    <tr>
                        <td>@i.Conceptos</td>
                        <td>@i.Recibos</td>
                        <td style="text-align:center">@i.Cantidades</td>
                        <td style="text-align:right">@i.Montos.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
        @{
            decimal totalIngresos = Model.TotalIngresos;
            decimal totalEgresos = Model.TotalEgresos;
            decimal totalEfectivoEntregar = totalIngresos - totalEgresos;
