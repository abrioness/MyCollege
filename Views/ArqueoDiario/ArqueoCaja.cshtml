<script src="https://cdn.jsdelivr.net/npm/numero-a-letras@1.0.6/index.min.js"></script>
<script>
    // Selección de recinto: solo un checkbox a la vez; actualiza el hidden IdRecinto
    document.querySelectorAll(".recinto-checkbox").forEach(function (cb) {
        cb.addEventListener("change", function () {
            if (this.checked) {
                document.querySelectorAll(".recinto-checkbox").forEach(function (other) { other.checked = false; });
                this.checked = true;
                document.getElementById("IdRecintoHidden").value = this.value;
            } else {
                document.getElementById("IdRecintoHidden").value = "";
            }
        });
    });
    // Al cargar, sincronizar hidden con el checkbox marcado
    document.addEventListener("DOMContentLoaded", function () {
        var checked = document.querySelector(".recinto-checkbox:checked");
        if (checked) document.getElementById("IdRecintoHidden").value = checked.value;
    });

    // Evitar doble envío y validar recinto (solo Admin con lista)
    var envioArqueoEnCurso = false;
    document.getElementById("formArqueo").addEventListener("submit", function (e) {
        if (envioArqueoEnCurso) {
            e.preventDefault();
            return false;
        }
        if (@(requiereRecintoAdmin ? "true" : "false")) {
            var idRecinto = document.getElementById("IdRecintoHidden").value;
            if (!idRecinto || idRecinto === "0") {
                e.preventDefault();
                if (typeof Swal !== "undefined") {
                    Swal.fire({ title: "Atención", text: "Debe seleccionar el recinto a arquear.", icon: "warning", confirmButtonText: "Aceptar" });
                } else {
                    alert("Debe seleccionar el recinto a arquear.");
                }
                return false;
            }
        }
        envioArqueoEnCurso = true;
        var btn = document.getElementById("btnGuardarArqueo");
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando…';
        }
    });

    function parseMonto(input) {
        if (!input) return 0;
        var texto = (typeof input === "string" ? input : input.value) || "";
        var n = parseFloat(String(texto).replace(/[^0-9.-]+/g, ""));
        return isNaN(n) ? 0 : n;
    }

    function formatoCordoba(valor) {
        return "C$ " + valor.toLocaleString("es-NI", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Total ingresos − egresos (efectivo a entregar según libros)
    function getTotalEfectivoEntregar() {
        var ingresos = parseMonto(document.getElementById("totalIngresosValor"));
        var egresos = parseMonto(document.getElementById("totalEgresosValor"));
        return Math.round((ingresos - egresos) * 100) / 100;
    }

    function actualizarTotalesLibro() {
        var efectivo = getTotalEfectivoEntregar();
        var elHidden = document.getElementById("totalEfectivoEntregarValor");
        if (elHidden) elHidden.value = efectivo.toFixed(2);
        var elHiddenDetalle = document.querySelector('input[name="arqueoDiario.TotalDetalleEfectivo"]');
        if (elHiddenDetalle) elHiddenDetalle.value = efectivo.toFixed(2);
        var texto = formatoCordoba(efectivo);
        var elTop = document.getElementById("textoTotalEfectivoEntregar");
        var elDetalle = document.getElementById("textoTotalDetalleEfectivo");
        if (elTop) elTop.textContent = texto;
        if (elDetalle) elDetalle.textContent = texto;
        return efectivo;
    }

    function getTotalDolaresUsd() {
        return parseMonto(document.getElementById("totalGeneralDolares"));
    }

    function getTasaCambio() {
        var el = document.querySelector(".cantidadcambio");
        return el ? parseMonto(el) : 0;
    }

    function actualizarEquivalenteDolares() {
        var totalDolares = getTotalDolaresUsd();
        var tasa = getTasaCambio();
        var equivalente = Math.round(totalDolares * tasa * 100) / 100;
        var elEq = document.getElementById("EquivalenteCordoba");
        if (elEq) elEq.value = formatoCordoba(equivalente);
        return equivalente;
    }

    // Conteo físico: córdobas + dólares convertidos a córdobas
    function getTotalDetalleDinero() {
        var totalC = parseMonto(document.getElementById("totalGeneralCordobas"));
        var equivalente = actualizarEquivalenteDolares();
        return Math.round((totalC + equivalente) * 100) / 100;
    }

    // Convertir número a letras en español (usa librería si existe, si no formato con centavos)
    function numeroALetrasJS(valor) {
        if (typeof valor !== "number" || isNaN(valor)) valor = 0;
        var entero = Math.floor(valor);
        var centavos = Math.round((valor - entero) * 100);
        var texto = "";
        if (typeof window.numeroALetras === "function") {
            try {
                texto = window.numeroALetras(valor);
            } catch (e) { }
        }
        if (typeof window.NumeroALetras === "function" && !texto) {
            try {
                texto = window.NumeroALetras(valor);
            } catch (e) { }
        }
        if (!texto) {
            texto = entero.toLocaleString("es-NI") + " CÓRDOBAS";
            if (centavos > 0) texto += " CON " + centavos.toString().padStart(2, "0") + "/100";
        }
        return (texto + "").toUpperCase();
    }

    // Actualizar TOTAL DETALLE DE DINERO, Diferencia y Total en Letras
    function updateTotalDetalleYDiferencia() {
        totalGeneralCordobas();
        totalGeneralDolares();

        var totalEfectivo = actualizarTotalesLibro();
        var totaDetalleDinero = getTotalDetalleDinero();

        var elDetalle = document.getElementById("valorTotalDetalleDinero");
        if (elDetalle) elDetalle.textContent = formatoCordoba(totaDetalleDinero);

        var diferencia = Math.round((totalEfectivo - totaDetalleDinero) * 100) / 100;
        var elDiff = document.getElementById("valorDiferencia");
        var elTipo = document.getElementById("tipoDiferencia");
        if (elDiff) elDiff.textContent = formatoCordoba(Math.abs(diferencia));
        if (elTipo) {
            if (Math.abs(diferencia) < 0.01) elTipo.textContent = "(Cuadrado)";
            else if (diferencia > 0) elTipo.textContent = "(Faltante en caja)";
            else elTipo.textContent = "(Sobrante en caja)";
        }

        var valorParaLetras = totaDetalleDinero > 0.01 ? totaDetalleDinero : totalEfectivo;
        var elLetras = document.getElementById("totalEnLetrasTexto");
        if (elLetras) elLetras.textContent = numeroALetrasJS(valorParaLetras);
    }

    function totalGeneralCordobas() {
        var total = 0;
        document.querySelectorAll("tbody .totalc").forEach(function (input) {
            total += parseMonto(input);
        });
        var el = document.getElementById("totalGeneralCordobas");
        if (el) el.value = formatoCordoba(total);
        return total;
    }

    function totalGeneralDolares() {
        var total = 0;
        document.querySelectorAll("tbody .totald").forEach(function (input) {
            total += parseMonto(input);
        });
        var el = document.getElementById("totalGeneralDolares");
        if (el) el.value = "$ " + total.toLocaleString("es-NI", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return total;
    }

    var elTasaCambio = document.querySelector(".cantidadcambio");
    if (elTasaCambio) {
        elTasaCambio.addEventListener("input", function () {
            updateTotalDetalleYDiferencia();
        });
    }



    document.querySelectorAll(".cantidadc").forEach(input => {
        input.addEventListener("input", function () {
            var cantidad = parseInt(this.value, 10) || 0;
            var precio = parseFloat(this.dataset.precio);
            var total = cantidad * precio;
            var totalInput = this.closest("tr").querySelector(".totalc");
            totalInput.value = "C$ " + total.toLocaleString("es-NI", { minimumFractionDigits: 2 });
            updateTotalDetalleYDiferencia();
        });
    });
    document.querySelectorAll(".cantidadd").forEach(input => {
        input.addEventListener("input", function () {
            var cantidad = parseInt(this.value, 10) || 0;
            var precio = parseFloat(this.dataset.precio);
            var total = cantidad * precio;
            var totalInput = this.closest("tr").querySelector(".totald");
            totalInput.value = "$ " + total.toLocaleString("es-NI", { minimumFractionDigits: 2 });
            updateTotalDetalleYDiferencia();
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        actualizarTotalesLibro();
        updateTotalDetalleYDiferencia();
    });
</script>
@if (TempData["Mensaje"] != null)
{
    var tipoMsg = TempData["Tipo"]?.ToString() ?? "info";
    var tituloMsg = tipoMsg == "success" ? "Éxito" : tipoMsg == "warning" ? "Atención" : "Información";
    var iconoSwal = tipoMsg == "success" ? "success" : tipoMsg == "warning" ? "warning" : "info";
    var abrirImpresion = Model.AbrirImpresion;
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var titulo = @Html.Raw(Json.Serialize(tituloMsg));
            var icono = @Html.Raw(Json.Serialize(iconoSwal));
            var abrirImpresion = @(abrirImpresion ? "true" : "false");
            function despuesMensaje() {
                if (abrirImpresion) {
                    setTimeout(function () { window.print(); }, 400);
                }
            }
            if (typeof Swal !== "undefined" && typeof Swal.fire === "function") {
                Swal.fire({
                    title: titulo,
                    text: mensaje,
                    icon: icono,
                    confirmButtonText: abrirImpresion ? "Aceptar e imprimir" : "Aceptar"
                }).then(function () { despuesMensaje(); });
            } else {
                window.alert(titulo + "\n\n" + mensaje);
                despuesMensaje();
            }
        });
    </script>
}
else if (Model.AbrirImpresion)
{
    @* Mensaje consumido pero quedó solo la impresión (caso raro) *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(function () { window.print(); }, 400);
        });
    </script>
}