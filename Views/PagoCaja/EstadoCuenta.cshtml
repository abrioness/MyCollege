@model WebColegio.Models.ViewModel.EstadoCuentaViewModel
@{
	ViewData["Title"] = "Estado De Cuenta Cajera";
}

<div class="container-fluid p-1" style="margin:2px;">
	<div class="card shadow-lg p-3 mb-5 bg-white rounded">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Estado Cuenta del Estudiante</h5>
		</div>
		<div class="card-body">
			<div class="table-responsive" style="font-size: 12px;">
				<br />
				<div class="col-12 text-end">
					<div class="btn-group">
						<button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Agregar Pagos</button>
						<ul class="dropdown-menu">
							<li>
								<a class="dropdown-item" asp-action="Create" asp-controller="Pagos">Agregar Pago de Mensualidad</a>
							</li>
							<li>
								<a class="dropdown-item" asp-action="Create" asp-controller="PagoCaja">Agregar Pagos Varios</a>
							</li>
						</ul>
					</div>
				</div>
				<br />
				<table id="estadocuenta" class="table table-bordered table-sm">
					<thead>
						<tr>
							<th>Alumno</th>
							<th>Grado</th>
							<th>Año lectivo</th>
							<th>Colegio</th>
							<th>Matrícula</th>
							<th>Rifa 1</th>
							<th>Rifa 2</th>
							<th>Promoción</th>
							<th>Enero</th>
							<th>Febrero</th>
							<th>Marzo</th>
							<th>Abril</th>
							<th>Mayo</th>
							<th>Junio</th>
							<th>Julio</th>
							<th>Agosto</th>
							<th>Septiembre</th>
							<th>Octubre</th>
							<th>Noviembre</th>
							<th>Diciembre</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var fila in Model.Filas ?? Enumerable.Empty<WebColegio.Models.ViewModel.EstadoCuentaFilaAlumno>())
						{
							if (fila.DatosIncompletos)
								continue;
							<tr>
								<td data-order="@(fila.IdPagoParaEnlace ?? 0)">
									<span class="btn btn-sm btn-info">@fila.NombreCompleto</span>
								</td>
								<td>@(fila.NombreGrado ?? "-")</td>
								<td>@(fila.AnioPeriodo > 0 ? fila.AnioPeriodo.ToString() : "—")</td>
								<td>
									@(fila.Recinto ?? "—")
									@if (!string.IsNullOrWhiteSpace(fila.EtiquetaRecinto))
									{
										<span class="badge @(fila.EsHistorialTraslado ? "bg-secondary" : "bg-primary")">@fila.EtiquetaRecinto</span>
									}
								</td>
								<td class="text-center">
									@if (fila.MatriculaReferencia <= 0.01m)
									{
										<span class="text-muted">—</span>
									}
									else if (fila.MatriculaCancelada)
									{
										<span class="badge bg-success">Pagado</span>
									}
									else if (fila.TieneAbonoMatricula)
									{
										<span class="badge bg-warning text-dark">Abono</span>
									}
									else
									{
										<span class="badge bg-warning text-dark">Pendiente</span>
									}
								</td>
								<td class="text-center">
									@if (!fila.AplicaRifaSemestre1)
									{
										<span class="text-muted" title="Matrícula posterior a la generación de la rifa 1">No aplica</span>
									}
									else if (fila.RifaSemestre1Pagada)
									{
										<span class="badge bg-success">Pagado</span>
									}
									else
									{
										<span class="badge bg-warning text-dark">Pendiente</span>
									}
								</td>
								<td class="text-center">
									@if (!fila.AplicaRifaSemestre2)
									{
										<span class="text-muted" title="Matrícula posterior a la generación de la rifa 2">No aplica</span>
									}
									else if (fila.RifaSemestre2Pagada)
									{
										<span class="badge bg-success">Pagado</span>
									}
									else
									{
										<span class="badge bg-warning text-dark">Pendiente</span>
									}
								</td>
								<td class="text-center">
									@if (!fila.AplicaPromocion)
									{
										<span class="text-muted" title="Solo 3er nivel, 6.° y 11.°">—</span>
									}
									else if (fila.PromocionPagada)
									{
										<span class="badge bg-success">Pagado</span>
									}
									else
									{
										<span class="badge bg-warning text-dark">Pendiente</span>
									}
								</td>
								@foreach (var cel in fila.Meses ?? Array.Empty<WebColegio.Models.ViewModel.EstadoCuentaMesCelda>())
								{
									<td class="text-center">
										@if (cel.NoCorresponde)
										{
											<span class="text-muted">—</span>
										}
										else if (cel.Cancelado)
										{
											<span class="badge bg-success">Pagado</span>
										}
										else if (cel.TieneAbonoParcial)
										{
											<span class="badge bg-warning text-dark">Abono</span>
										}
										else
										{
											<span class="badge bg-warning text-dark">Pendiente</span>
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script>
	$(document).ready(function () {
		$('#estadocuenta').DataTable({
			responsive: false,
			pageLength: 10,
			lengthMenu: [[5, 10, 20], [5, 10, 20]],
			paging: true,
			order: [[0, 'desc']],
			dom: 'lfrtip',
			language: {
				url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
			}
		});
	});
</script>
