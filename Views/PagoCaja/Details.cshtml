@model WebColegio.Models.ViewModel.pagoCajasViewModel
@using WebColegio.Helpers

@{
    Layout = null;
    ViewData["Title"] = "Impresión de Recibo";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recibo de Caja - @Model.PagosCaja.NumeroRecibo</title>
    <link rel="stylesheet" href="~/css/voucher-tmu220.css" />
</head>
<body>
    @{
        var recinto = Model.recintos
        .FirstOrDefault(s => s.Value == Model.PagosCaja.IdRecinto.ToString());

    }
    <div class="voucher">


        <!-- Encabezado -->
        <div class="v-header">
			
            <div class="title">
				
					@recinto?.Text
                </div>
           @if (recinto?.Text == "COLEGIO PARROQUIAL SAN FRANCISCO JAVIER")
			{
                    <div class="sub">VICARIA DE EDUCACIÓN CATÓLICA</div>
                    <div class="sub">Ciudad Sandino, Plaza Padre Miguel, 2c. al Norte, Zona #4 Managua</div>
            }
           @if (recinto?.Text == "CENTRO EDUCATIVO PARROQUIAL SAN MIGUEL ARCANGEL")
			{
                <div class="sub">VICARIA DE EDUCACIÓN CATÓLICA</div>
                <div class="sub">Ciudad Sandino, Frente de donde fue la Bomba de la Ruta 172, Zona #11 Managua</div>
            }
                
           
        </div>

        <div class="v-section">
            <div class="v-row center bold">RECIBO DE CAJA</div>
            <div class="v-row">Serie: <span>@Model.PagosCaja.Serie</span></div>
            <div class="v-row">N°: <span>@Model.PagosCaja.NumeroRecibo</span></div>
        </div>

        @{
           
            var grado = Model.grados?.FirstOrDefault(a => a.IdGrado == Model.PagosCaja.IdGrado);
            var tipoMovimiento = Model.tipoMovimiento?.FirstOrDefault(a => a.IdTipoMovimiento == Model.PagosCaja.Concepto);
            var turno = Model.turnos?.FirstOrDefault(a => a.IdTurno == Model.PagosCaja.IdTurno);
            var fechaPago = Model.PagosCaja.FechaEmision;
            var fechaEmision = Model.PagosCaja.FechaRegistro;
            var fecha = fechaEmision != default ? fechaEmision : (fechaPago ?? DateTime.Now);
            var descripcionVisible = EstadoCuentaCalculoHelper.QuitarMarcasInternasDescripcion(Model.PagosCaja.Descripcion);
            var conceptoVisible = string.IsNullOrWhiteSpace(descripcionVisible)
                ? (tipoMovimiento?.Concepto ?? "—")
                : string.IsNullOrWhiteSpace(tipoMovimiento?.Concepto)
                    ? descripcionVisible
                    : $"{tipoMovimiento.Concepto}: {descripcionVisible}";
        }
        <div class="v-section">
            <div class="v-row"><b>Recibí de:</b> <span>@Model.PagosCaja.Nombre</span></div>
            <div class="v-row"><b>Nivel:</b> <span>@grado?.NombreGrado</span></div>
            <div class="v-row"><b>Fecha de pago:</b> <span>@(fechaPago?.ToString("dd/MM/yyyy") ?? "—")</span></div>
            <div class="v-row"><b>Fecha de emisión:</b> <span>@(fechaEmision != default ? fechaEmision.ToString("dd/MM/yyyy") : "—")</span></div>
            <div class="v-row"><b>Concepto:</b> <span>@conceptoVisible</span></div>
            <div class="v-row"><b>Turno:</b> <span>@turno?.NombreTurno</span></div>
            <div class="v-row"><b>La cantidad de:</b> <span>C$ @Model.PagosCaja.Monto.ToString("N2")</span></div>
           @*  <div class="v-row"><b>En letras:</b><br />@Model.cantidadEnLetras (C$ @Model.PagosCaja.Monto)</div> *@
        </div>
          
       
        <!-- Fecha -->
        <div class="v-section center">
            Managua: @fecha.Day de
            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(fecha.Month)
            del 20@{@fecha.ToString("yy")}
        </div>

        <!-- Firma -->
        <div class="firma">
            <div class="line"></div>
            <div class="txt">Firma y Sello del Cajero</div>
            <div class="txt">
                @Model.listPagoCaja.FirstOrDefault(a => a.UsuarioRegistro == Model.PagosCaja.UsuarioRegistro)
            </div>
        </div>
    </div>

    
    <div class="no-print center">
        <button class="print-button " onclick="window.print()">🖨️ Imprimir</button>
        <a asp-action="Create" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>

    </div>


   
</body>

</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<script src="~/js/limpiarcampos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
            Swal.fire({
                title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
                text: mensaje,
                icon: tipo,
                confirmButtonText: "Aceptar"
            });
        });
    </script>
}