@model WebColegio.Models.ViewModel.pagoCajasViewModel
@using Newtonsoft.Json

@*@{
    ViewData["Title"] = "Create";
}
<div class="content">
     <div class="modal-body">
        <span class="h5 mb-1">Bienvenido: @TempData["nombreusuario"] </span>
    </div> *@


<div class="container mt-6">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">

            <h4 class="mb-0"><i class="bi bi-cash-coin"></i> Registro de Recibo de Caja Varios</h4>

        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="PagosCaja.NumeroRecibo" class="control-label">Número Recibo</label>
                            <input asp-for="PagosCaja.NumeroRecibo" value="@Model.SiguienteNumero" id="numeroRecibo" class="form-control" readonly />
                            <span asp-validation-for="PagosCaja.NumeroRecibo" class="text-danger"></span>
                        </div>


                       
                        <div class="form-group">
                            <label asp-for="PagosCaja.Nombre">Recibi De:</label>
                            <input type="text" asp-for="PagosCaja.Nombre" id="AlumnoNombre" class="form-control" placeholder="Buscar Alumno..." />
                            <span asp-validation-for="PagosCaja.Nombre" class="text-danger"></span>
                            <input type="hidden" id="IdAlumno" name="idAlumno" value="" />
                        </div>
                        
                            <div class="form-group">
                                <label asp-for="PagosCaja.IdGrado" class="control-label">Nivel</label>
                                <select asp-for="PagosCaja.IdGrado" asp-items="Model.gradosSelectListItem" class="form-select" required>
                                    <option value="">Seleccione una Opción</option>
                                </select>
                                <span asp-validation-for="PagosCaja.IdGrado" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="PagosCaja.IdTurno" class="control-label">Turno</label>
                                <select asp-for="PagosCaja.IdTurno" asp-items="Model.turnosSelectListItem" class="form-select" required>
                                    <option value="">Seleccione una Opción</option>
                                </select>
                                <span asp-validation-for="PagosCaja.IdTurno" class="text-danger"></span>
                            </div>
                        <div class="form-group">
                            <label asp-for="PagosCaja.IdPeriodo" class="control-label">Ciclo Escolar</label>
                            <select asp-for="PagosCaja.IdPeriodo" asp-items="Model.periodo" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="PagosCaja.IdPeriodo" class="text-danger"></span>
                        </div>
                        <!-- Sección de Meses - Se muestra/oculta según el tipo de movimiento -->
                        <br />

                        
                    </div>
                 <div class="col-lg-6">
						@*     <div class="form-group">
                            <label asp-for="PagosCaja.Anyo" class="control-label">Año</label>
                            <select asp-for="PagosCaja.Anyo" class="form-select" required>
                                <option value="">Seleccione una Opciòn</option>
                                <option value="2022">2022</option>
                                <option value="2023">2023</option>
                                <option value="2024">2024</option>
                                <option value="2025">2025</option>
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                                <option value="2028">2028</option>
                                <option value="2029">2029</option>
                                <option value="2030">2030</option>
                            </select>

                        </div> *@
                        <div class="form-group">
                           
                            <label asp-for="PagosCaja.FechaEmision" class="control-label">Fecha de Emisión</label>
                            <input type="date" asp-for="PagosCaja.FechaEmision" pattern="\d{2}/\d{2}/\d{4}" placeholder="dd/mm/yyyy" class="form-control"  />
                            <span asp-validation-for="PagosCaja.FechaEmision" class="text-danger"></span>
                        </div>
                    <div class="form-group">
                        <label asp-for="PagosCaja.Serie" class="control-label">Serie:</label>
                        <input asp-for="PagosCaja.Serie" id="serie" class="form-control" readonly value="A" />
                        <span asp-validation-for="PagosCaja.Serie" class="text-danger"></span>
                    </div>
                        <div class="form-group">
                            <label asp-for="PagosCaja.Concepto" class="control-label">En Concepto:</label>
                            <select asp-for="PagosCaja.Concepto" id="conceptoCaja" asp-items="Model.tipoMovimientoSelectListItem" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="PagosCaja.Concepto" class="text-danger"></span>
                        </div>
                        <div class="form-group" id="grupoSemestreRifa" style="display:none;">
                            <label class="control-label">Semestre de rifa</label>
                            <select name="semestreRifa" id="semestreRifa" class="form-select">
                                <option value="1">Primer semestre (enero–junio)</option>
                                <option value="2">Segundo semestre (julio–diciembre)</option>
                            </select>
                            <small class="text-muted">Si ambas están pendientes, este pago cancela siempre el primer semestre. El siguiente recibo cancela el segundo.</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="PagosCaja.IdRecinto" class="control-label">Centro de Estudio</label>
                            <select asp-for="PagosCaja.IdRecinto" asp-items="Model.recintos" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="PagosCaja.IdRecinto" class="text-danger"></span>
                        </div>
                        
                        

                        <!-- Productos del recibo: afectar inventario -->
                        <div class="form-group mt-3">
                            <label class="control-label">Productos (afectar inventario)</label>
                            <p class="text-muted small">Si este recibo incluye venta de librería, uniformes, etc., agregue los productos para descontar el stock automáticamente.</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalProductos">
                                <i class="bi bi-plus-circle"></i> Agregar producto
                            </button>
                            <div class="form-group">
                                <label asp-for="PagosCaja.Monto" class="control-label">La Cantidad de (C$):</label>
                                <input asp-for="PagosCaja.Monto" id="monto" class="form-control" step="0.01" min="0" />
                                <small class="text-muted" id="montoAyuda">Se calcula automáticamente al agregar productos. Puede editarlo si el recibo no incluye inventario.</small>
                                <span asp-validation-for="PagosCaja.Monto" class="text-danger"></span>
                            </div>
                            <div id="contenedorDetalle" class="mt-2" style="display: none;">
                                <table class="table table-sm table-bordered" id="tablaDetalleItems">
                                    <thead>
                                        <tr>
                                            <th>Categoría</th>
                                            <th>Producto</th>
                                            <th class="text-end">Precio unit.</th>
                                            <th class="text-center">Cant.</th>
                                            <th class="text-end">Subtotal</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot>
                                        <tr class="table-light">
                                            <td colspan="4" class="text-end fw-semibold">Total productos:</td>
                                            <td class="text-end fw-bold" id="celdaTotalDetalle">C$ 0.00</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="PagosCaja.Descripcion" class="control-label">Observaciones</label>
                            <textarea asp-for="PagosCaja.Descripcion" class="form-control"></textarea>

                        </div>
                          
                </div>
                    <!-- Modal Productos (inventario) -->
                    <div class="modal fade" id="modalProductos" tabindex="-1" aria-labelledby="modalProductosLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalProductosLabel">Agregar producto al recibo</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-2">
                                        <label class="form-label">Categoría</label>
                                        <select id="modalCategoria" class="form-select">
                                            <option value="">Seleccione categoría (ej. Librería, Uniforme)</option>
                                            @foreach (var cat in Model.CategoriasProducto ?? new List<WebColegio.Models.CategoriaProducto>())
                                            {
                                                <option value="@cat.IdCateProducto">@cat.NombreCategoria</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Producto</label>
                                        <select id="modalProducto" class="form-select">
                                            <option value="">Seleccione producto</option>
                                        </select>
                                        <span class="text-muted small" id="modalStockInfo"></span>
                                        <span class="text-muted small d-block" id="modalPrecioInfo"></span>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Cantidad</label>
                                        <input type="number" id="modalCantidad" class="form-control" min="1" value="1" />
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label">Subtotal línea</label>
                                        <input type="text" id="modalSubtotalLinea" class="form-control" readonly />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    <button type="button" class="btn btn-primary" id="btnAgregarProducto">Agregar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <!-- Modal meses (comentado) -->
					@*  <div class="modal fade" id="modalMeses" tabindex="-1" aria-labelledby="modalMesesLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Seleccionar meses</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        @foreach (var itemMeses in Model.meses)
                                        {

                                            <div class="col-md-4 mb-2">
                                                <div class="form-check">
                                                    <input type="checkbox"
                                                           name="MesesSeleccionados"
                                                           value="@itemMeses.IdMes"
                                                           class="form-check-input" id="mes_@itemMeses.IdMes" />
                                                    <label class="form-check-label" for="mes_@itemMeses.IdMes">
                                                        @itemMeses.Mes
                                                    </label>
                                                     <input type="hidden" asp-for="@itemMeses.IdMes" /> *@
                                                    @* <input type="hidden" asp-for="mesesSelectListItem[i].Value" /> 
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    <button type="button" class="btn btn-primary" onclick="confirmarMeses()">Confirmar</button>
                                </div>
                            </div>
                        </div>
                    </div>*@




                </div>


                <!-- Hidden inputs para DetalleItems (se rellenan por JS) -->
                <div id="detalleItemsHidden"></div>

                <br />
                <!-- Botones -->
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Procesar Pago
                    </button>
                   @*  <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a> *@
                    <button type="button" id="btnLimpiar" class="btn btn-warning">
                        <i class="bi bi-trash3"></i> Limpiar Campos
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>
@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<script src="~/js/limpiarcampos.js"></script>
@* <script src="~/js/mensajecamprequerido.js"></script> *@
<script src="~/seewtalert/sweetalert.all.min.js"></script>
<script src="~/seewtalert/sweetalertstyle.js"></script>
<link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />


<script>
            (function() {
                 const $alumnoNombre = $('#AlumnoNombre');


        $alumnoNombre.autocomplete({
                   source: function(request, response) {
                       $.ajax({
                           url: '@Url.Action("Buscar", "Alumnos")',
                           data: { q: request.term },
                           success: function(data) {
                               response($.map(data, function(item) {
                                   return {
                                       label: item.nombreCompleto,
                                       value: item.nombreCompleto,
                                       id: item.id
                                   };
                               }));
                           },
                           error: function() {
                               response([]);
                           }
                       });
                   },
                   minLength: 2,
                   select: function(event, ui) {
                       $('#IdAlumno').val(ui.item.id);
                       $.getJSON('@Url.Action("ObtenerDatosAlumnoMatricula", "Pagos")', { idAlumno: ui.item.id })
                           .done(function(data) {
                               if (!data || !data.ok) return;
                               if (data.idGrado) $('#PagosCaja_IdGrado').val(String(data.idGrado));
                               if (data.idTurno) $('#PagosCaja_IdTurno').val(String(data.idTurno));
                               if (data.idRecinto) $('#PagosCaja_IdRecinto').val(String(data.idRecinto));
                               if (data.idPeriodo) $('#PagosCaja_IdPeriodo').val(String(data.idPeriodo));
                           });
                   }
               });

                 function esConceptoRifa() {
                     var txt = ($('#conceptoCaja option:selected').text() || '').toLowerCase();
                     return txt.indexOf('rifa') >= 0;
                 }
                 function toggleSemestreRifa() {
                     var mostrar = esConceptoRifa();
                     $('#grupoSemestreRifa').toggle(mostrar);
                     if (mostrar && !$('#semestreRifa').val()) {
                         $('#semestreRifa').val(new Date().getMonth() <= 5 ? '1' : '2');
                     }
                 }
                 $('#conceptoCaja').on('change', toggleSemestreRifa);
                 toggleSemestreRifa();
               })();

        // --- Productos / inventario en recibo ---
        var productosData = @Html.Raw(JsonConvert.SerializeObject(Model.Productos ?? new List<WebColegio.Models.Productos>()));
        var categoriasData = @Html.Raw(JsonConvert.SerializeObject(Model.CategoriasProducto ?? new List<WebColegio.Models.CategoriaProducto>()));
        var detalleItems = [];

        function getCategoriaNombre(id) {
            var c = categoriasData.find(function(x) { return (x.IdCateProducto || x.idCateProducto) === id; });
            return c ? (c.NombreCategoria || c.nombreCategoria) : '';
        }

        function getProd(obj, key) {
            if (!obj) return undefined;
            if (obj[key] !== undefined) return obj[key];
            var k = key.charAt(0).toLowerCase() + key.slice(1);
            return obj[k];
        }

        function formatoMoneda(n) {
            return 'C$ ' + (Number(n) || 0).toLocaleString('es-NI', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function actualizarSubtotalModal() {
            var idProd = parseInt($('#modalProducto').val(), 10);
            var cant = parseInt($('#modalCantidad').val(), 10) || 0;
            if (!idProd || cant < 1) {
                $('#modalSubtotalLinea').val('');
                return;
            }
            var prod = productosData.find(function(p) { return getProd(p, 'IdProducto') === idProd; });
            if (!prod) return;
            var precio = parseFloat(getProd(prod, 'CostoUnitario')) || 0;
            $('#modalSubtotalLinea').val(formatoMoneda(precio * cant));
        }

        function calcularTotalMonto() {
            var total = detalleItems.reduce(function(sum, item) {
                return sum + (item.precioUnitario * item.cantidad);
            }, 0);
            $('#monto').val(total > 0 ? total.toFixed(2) : '');
            $('#celdaTotalDetalle').text(formatoMoneda(total));
            return total;
        }

        $('#modalCategoria').on('change', function() {
            var idCat = parseInt($(this).val(), 10);
            var $sel = $('#modalProducto');
            $sel.empty().append('<option value="">Seleccione producto</option>');
            $('#modalStockInfo').text('');
            $('#modalPrecioInfo').text('');
            $('#modalSubtotalLinea').val('');
            if (!idCat) return;
            productosData.filter(function(p) { return getProd(p, 'IdCateProducto') === idCat; })
                .forEach(function(p) {
                    var id = getProd(p, 'IdProducto');
                    var nombre = getProd(p, 'NombreProducto');
                    var stock = getProd(p, 'StockActual');
                    var precio = parseFloat(getProd(p, 'CostoUnitario')) || 0;
                    $sel.append('<option value="' + id + '" data-stock="' + stock + '" data-precio="' + precio + '">' +
                        nombre + ' — ' + formatoMoneda(precio) + ' (Stock: ' + stock + ')</option>');
                });
        });

        $('#modalProducto, #modalCantidad').on('change input', function() {
            var opt = $('#modalProducto').find('option:selected');
            var stock = opt.data('stock');
            var precio = parseFloat(opt.data('precio')) || 0;
            $('#modalStockInfo').text(stock !== undefined && stock !== '' ? 'Stock actual: ' + stock : '');
            $('#modalPrecioInfo').text(precio > 0 ? 'Precio unitario: ' + formatoMoneda(precio) : '');
            actualizarSubtotalModal();
        });

        function refrescarTablaYHidden() {
            var $tbody = $('#tablaDetalleItems tbody');
            $tbody.empty();
            var $hidden = $('#detalleItemsHidden');
            $hidden.empty();
            detalleItems.forEach(function(item, i) {
                var sub = item.precioUnitario * item.cantidad;
                $tbody.append(
                    '<tr>' +
                    '<td>' + item.nombreCategoria + '</td>' +
                    '<td>' + item.nombreProducto + '</td>' +
                    '<td class="text-end">' + formatoMoneda(item.precioUnitario) + '</td>' +
                    '<td class="text-center">' + item.cantidad + '</td>' +
                    '<td class="text-end">' + formatoMoneda(sub) + '</td>' +
                    '<td><button type="button" class="btn btn-outline-danger btn-sm quitar-item" data-idx="' + i + '"><i class="bi bi-trash"></i></button></td>' +
                    '</tr>'
                );
                $hidden.append('<input type="hidden" name="DetalleItems[' + i + '].IdProducto" value="' + item.idProducto + '" />');
                $hidden.append('<input type="hidden" name="DetalleItems[' + i + '].Cantidad" value="' + item.cantidad + '" />');
            });
            $('#contenedorDetalle').toggle(detalleItems.length > 0);
            calcularTotalMonto();
        }

        $('#btnAgregarProducto').on('click', function() {
            var idProd = parseInt($('#modalProducto').val(), 10);
            var cant = parseInt($('#modalCantidad').val(), 10) || 1;
            if (!idProd) {
                Swal.fire({ title: 'Atención', text: 'Seleccione un producto.', icon: 'warning' });
                return;
            }
            var prod = productosData.find(function(p) { return getProd(p, 'IdProducto') === idProd; });
            if (!prod) return;
            var stockActual = parseInt(getProd(prod, 'StockActual'), 10) || 0;
            var precioUnitario = parseFloat(getProd(prod, 'CostoUnitario')) || 0;

            var existente = detalleItems.find(function(x) { return x.idProducto === idProd; });
            var cantTotal = (existente ? existente.cantidad : 0) + cant;
            if (cantTotal > stockActual) {
                Swal.fire({ title: 'Atención', text: 'La cantidad total (' + cantTotal + ') supera el stock (' + stockActual + ').', icon: 'warning' });
                return;
            }

            if (existente) {
                existente.cantidad = cantTotal;
            } else {
                detalleItems.push({
                    idProducto: idProd,
                    cantidad: cant,
                    precioUnitario: precioUnitario,
                    nombreProducto: getProd(prod, 'NombreProducto'),
                    nombreCategoria: getCategoriaNombre(getProd(prod, 'IdCateProducto'))
                });
            }

            refrescarTablaYHidden();
            $('#modalCantidad').val(1);
            $('#modalSubtotalLinea').val('');
            var modalEl = document.getElementById('modalProductos');
            if (modalEl && window.bootstrap) {
                bootstrap.Modal.getInstance(modalEl)?.hide();
            }
        });

        $(document).on('click', '.quitar-item', function() {
            detalleItems.splice(parseInt($(this).data('idx'), 10), 1);
            refrescarTablaYHidden();
        });

        $('form').on('submit', function(e) {
            if (detalleItems.length > 0) {
                calcularTotalMonto();
                var monto = parseFloat($('#monto').val()) || 0;
                if (monto <= 0) {
                    e.preventDefault();
                    Swal.fire({ title: 'Atención', text: 'El total a pagar debe ser mayor que cero.', icon: 'warning' });
                }
            }
        });
</script>


@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            Swal.fire({
                title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
         TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
         "Información")',
                text: mensaje,
                icon: '@TempData["Tipo"]',
                confirmButtonText: 'Aceptar'
            });
        });
    </script>
}
}