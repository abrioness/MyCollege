@model WebColegio.Models.ViewModel.ColeccionCatalogos
@using WebColegio.Helpers
@* @{
	ViewData["Title"] = "Index";
} *@
<script src="~/js/site.js"></script>
@* <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" /> *@
<div class="container mt-auto" style="padding:2px;">
	<div class="card shadow-lg p-3 mb-5 bg-white rounded">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi bi-clipboard-check"></i> Reporte de Inventario</h5>
		</div>
		<div class="card-body">
			@{
				var productosBajoMinimo = (Model.producto ?? new List<WebColegio.Models.Productos>())
					.Where(p => p.Activo && InventarioAlertaHelper.EstaBajoMinimo(p))
					.ToList();
			}
			@if (productosBajoMinimo.Count > 0)
			{
				<div class="alert alert-warning">
					<strong>Inventario bajo.</strong>
					Hay @productosBajoMinimo.Count producto(s) en o bajo el stock mínimo. Reponer existencias.
					<ul class="mb-0 mt-2">
						@foreach (var p in productosBajoMinimo.Take(8))
						{
							<li>@InventarioAlertaHelper.TextoAlerta(p)</li>
						}
					</ul>
				</div>
			}
			<div class="table-responsive" style="font-size:12px">
				<div class="col-4 text-center">
					@using (Html.BeginForm("Index", "Productos", FormMethod.Get))
					{
						<div class="row">
							<div class="col-4">
								<label class="control-label">Desde:</label>
								<input type="date" name="fechainicio" id="FechaInicio" class="form-control"
								value="@@(Request.QueryString[" fechainicio"])" />
							</div>
							<div class="col-4">
								<label class="control-label">Hasta:</label>
								<input type="date" name="fechafin" id="FechaFin" class="form-control"
								value="@@(Request.QueryString[" fechafin"])" />
							</div>
							<div class="col-4">
								<br />
								<button type="submit" class="form-control btn btn-success">Filtrar</button>
							</div>
						</div>
					}
				</div>
				<div class="col-12 text-end">
					<a asp-action="Movimientos" class="btn btn-outline-secondary me-1">
						<i class="bi bi-arrow-left-right"></i> Entradas y salidas
					</a>
					@{
						var userRol = User.IsInRole("Cajero") ? true : false;
						@if(!userRol)
					 {
				<a asp-action="Create" class="btn btn-primary" >
					<i class="bi bi-plus-circle"></i> Agregar Inventario
				</a>
					 }
				}
			</div>
			<br />
			<div class="table-responsive" style="font-size: 12px;">
					<table id="tablaProducto" class="table table-bordered table-sm">
				@* class="display responsive nowrap" style="width:100%"> *@
				<thead>
					<tr>
						<th>Código</th>
						<th>Nombre Producto</th> 
						<th>Descripción</th>
								<th>Colegio</th>
						<th>Existencia Inicial</th>
						<th>Entrada</th>
						<th>Salida</th>
						<th>Stock Actual</th>
						<th>Stock mínimo</th>
						<th>Proveedor</th>
						<th>Precio de venta</th>
						<th>Categoría</th>
						<th>Importe de Inventario</th>
						<th class="col-fecha">Fecha Registro</th>
						<th>Precio de compra</th>
						@if (User.IsInRole("Admin") || User.IsInRole("UserSystem"))
						{
							<th class="no-export">Acciones</th>
						}
					</tr>
				</thead>
				<tbody>
					@foreach (var itemProducto in Model.producto)
					{
						var bajoMinimo = InventarioAlertaHelper.EstaBajoMinimo(itemProducto);
						var minimo = InventarioAlertaHelper.StockMinimoEfectivo(itemProducto.StockMinimo);
						var proveedor = Model.proveedores?.FirstOrDefault(p => p.IdProveedor == itemProducto.IdProveedor);
						<tr class="@(bajoMinimo ? "table-warning" : "")">
							<td>
								@if (User.IsInRole("Admin") || User.IsInRole("UserSystem"))
								{
									<a asp-action="Edit" asp-route-id="@itemProducto.IdProducto" class="btn btn-sm btn-info" title="Editar">
										@itemProducto.CodigoBarra
									</a>
								}
								else
								{
									@itemProducto.CodigoBarra
								}
							</td>
							
									@*<td>

									<a asp-action="Index" asp-controller="Productos" asp-route-id="@itemProducto.IdProducto" class="btn btn-sm btn-info">	@itemProducto.NombreProducto</a>

							</td> *@
							
							<td>

								@itemProducto.NombreProducto
							</td>
									<td>

										@itemProducto.Descripcion
									</td>
									@{
										var colegio = Model.recintos.
										FirstOrDefault(a => a.IdRecinto == itemProducto.IdRecinto);
									}
									<td>
										@(string.IsNullOrEmpty(colegio?.Recinto)
																				? "Sin Datos"
																				: colegio.Recinto)

									</td>
							<td>

								@itemProducto.ExistenciaInicial
							</td>
							@{
								Model.TotalesMovimientoPorProducto.TryGetValue(itemProducto.IdProducto, out var totalesInv);
								int cantEntrada = totalesInv?.Entrada ?? itemProducto.ExistenciaInicial;
								int cantSalida = totalesInv?.Salida ?? 0;
							}
							<td class="text-end">@cantEntrada</td>
							<td class="text-end">@cantSalida</td>
							
							<td>
								@itemProducto.StockActual
								@if (bajoMinimo)
								{
									<span class="badge bg-warning text-dark ms-1">Bajo mínimo</span>
								}
							</td>
							<td>@minimo</td>
							<td>@(string.IsNullOrWhiteSpace(proveedor?.NombreProveedor) ? "—" : proveedor.NombreProveedor)</td>
							<td>
									C$ @itemProducto.PrecioParaVenta().ToString("N2")
							</td>
								
							<td>
									@{
										var itemCategoriaProducto = Model.categoriasProducto
										.FirstOrDefault(a => a.IdCateProducto == itemProducto.IdCateProducto);
									}
								@itemCategoriaProducto?.NombreCategoria
							</td>
							
							<td title="Stock actual × precio de compra">

								C$ @((itemProducto.StockActual * itemProducto.CostoUnitario).ToString("N2"))

							</td>
							<td>
								@itemProducto.FechaRegistro.ToString("dd/MM/yyyy")
								</td>
							<td>
									C$ @itemProducto.CostoUnitario.ToString("N2")
							</td>
							@if (User.IsInRole("Admin") || User.IsInRole("UserSystem"))
							{
								<td>
									<form asp-action="Anular" asp-controller="Productos" method="post" class="d-inline js-anular-recibo"
										  data-mensaje="¿Anular el producto @itemProducto.NombreProducto? Quedará desactivado y no se mostrará en el reporte.">
										@Html.AntiForgeryToken()
										<input type="hidden" name="id" value="@itemProducto.IdProducto" />
										<input type="hidden" name="fechainicio" value="@Context.Request.Query["fechainicio"]" />
										<input type="hidden" name="fechafin" value="@Context.Request.Query["fechafin"]" />
										<button type="submit" class="btn btn-sm btn-outline-danger" title="Anular producto">
											<i class="bi bi-x-circle"></i> Anular
										</button>
									</form>
								</td>
							}

						</tr>
					}
				</tbody>

			</table>
		</div>
		</div>
		</div>
	</div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script>
		$(document).ready(function () {
		var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");
		var botones = esCajero ? [] : [
			{
			extend: 'excelHtml5',
			text: 'Exportar a Excel',
			className: 'btn btn-success',
			exportOptions: { columns: ':not(.no-export)' }
			}
		];
		var colFecha = $('#tablaProducto thead th.col-fecha').index();
		if (colFecha < 0) colFecha = $('#tablaProducto thead th').length - 1;
		var colAcciones = $('#tablaProducto thead th.no-export').index();
		$(document).on('submit', 'form.js-anular-recibo', function (e) {
			e.preventDefault();
			var form = this;
			var mensaje = form.getAttribute('data-mensaje') || '¿Anular el producto?';
			if (typeof Swal === 'undefined') {
				if (window.confirm(mensaje)) form.submit();
				return;
			}
			Swal.fire({
				title: 'Atención',
				text: mensaje,
				icon: 'warning',
				showCancelButton: true,
				confirmButtonText: 'Anular',
				cancelButtonText: 'Cancelar'
			}).then(function (result) {
				if (result.isConfirmed) form.submit();
			});
		});
		$('#tablaProducto').DataTable({
		responsive: false,
		order: [[colFecha, 'desc']],
		pageLength: 10,
		lengthMenu: [[5, 10, 20], [5, 10, 20]],
		paging: true,
		dom: esCajero ? 'lfrtip' : 'Blfrtip',
		buttons: botones,
		columnDefs: colAcciones >= 0 ? [{ orderable: false, targets: colAcciones }] : [],
			language: {
				url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
			}
		});
	});
</script>
<script src="~/seewtalert/sweetalert.all.min.js"></script>
<link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />
@if (TempData["Mensaje"] != null)
{
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
			var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
			Swal.fire({
				title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
				text: mensaje,
				icon: tipo,
				confirmButtonText: "Aceptar"
			});
		});
	</script>
}
else if (productosBajoMinimo.Count > 0)
{
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			if (typeof Swal === "undefined") return;
			Swal.fire({
				title: "Atención",
				text: "Hay @productosBajoMinimo.Count producto(s) en o bajo el stock mínimo. Actualice el inventario.",
				icon: "warning",
				confirmButtonText: "Aceptar"
			});
		});
	</script>
}