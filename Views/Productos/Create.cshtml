@model WebColegio.Models.ViewModel.productoViewModel
@* @{
    ViewData["Title"] = "Create";
} *@
@*<div class="content">
     <div class="modal-body">
        <span class="h5 mb-1">Bienvenido: @TempData["nombreusuario"] </span>
    </div> *@




<div class="container mt-6">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi-clipboard-check"></i> Registro de Inventario</h4>
        </div>
        <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" id="siguienteNumero" value="@Model.SiguienteCodigo" />
            <div class="mb-3 p-3 border rounded bg-light">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="modoInventario" id="modoNuevo" value="nuevo" checked />
                    <label class="form-check-label" for="modoNuevo">Producto nuevo (se genera el siguiente código)</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="modoInventario" id="modoExistente" value="existente" />
                    <label class="form-check-label" for="modoExistente">Ingreso a un producto que ya existe</label>
                </div>
                <div id="panelBuscar" class="mt-3" style="display:none;">
                    <label class="form-label">Buscar producto existente</label>
                    <input type="text" id="buscarProducto" class="form-control" placeholder="Escriba código o nombre (ej. saca puntas o SACPUN-00010)" autocomplete="off" />
                    <small class="text-muted">Al elegirlo se carga el código. Solo indique la cantidad que ingresa.</small>
                    <div id="avisoExistente" class="alert alert-info mt-2 mb-0 py-2" style="display:none;"></div>
                </div>
            </div>
           <div class="row">
               <div class="col-lg-4">
                   @*          <div class="form-group">
                                <label asp-for="notas.IdAlumno">Nombre del Alumno</label>
                                <input type="text" id="AlumnoNombre" class="form-control" placeholder="Buscar alumno..." />
                                <input type="hidden" id="IdAlumno" name="notas.IdAlumno" />
                            </div> *@
                    
                        
                        <div class="form-group">
                            <label asp-for="tblproducto.CodigoBarra" class="control-label">Código de Producto</label>
                            <input  asp-for="tblproducto.CodigoBarra" id="CodigoProducto" value="@Model.SiguienteCodigo" class="form-control"  />
                            <span asp-validation-for="tblproducto.CodigoBarra" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.NombreProducto" class="control-label">Nombre Del Producto</label>
                            <input asp-for="tblproducto.NombreProducto" id="NombreProducto" class="form-control text-uppercase" />
                            <span asp-validation-for="tblproducto.NombreProducto" class="text-danger"></span>
                        </div>
                        @* <div class="form-group">
                            <label asp-for="tblproducto.Descripcion" class="control-label">Descripción</label>
                            <input type="text" asp-for="tblproducto.Descripcion" id="Descripcion" class="form-control" />
                          
                        </div> *@
                <div class="form-group">
                            <label asp-for="tblproducto.IdCateProducto" class="control-label">Categoría del Producto</label>
                            <select asp-for="tblproducto.IdCateProducto" asp-items="Model.listCategoriaProducto" class="form-select" required>
                                        <option disabled selected>Seleccione una Opción</option>
                                    </select>
                            <span asp-validation-for="tblproducto.IdCateProducto" class="text-danger"></span>
                </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.ExistenciaInicial" class="control-label">Cantidad / Existencia inicial</label>
                            <input asp-for="tblproducto.ExistenciaInicial" id="existenciaInicial" class="form-control" />
                            <span class="text-muted small">Producto nuevo: stock inicial. Si el código ya existe: cantidad que ingresa (se sumará al stock actual).</span>
                            <span asp-validation-for="tblproducto.ExistenciaInicial" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.IdMovInventario" class="control-label">Tipo Movimiento</label>
                            <select asp-for="tblproducto.IdMovInventario" asp-items="Model.listMovimientoInventario" class="form-select" required>
                                <option disabled selected>Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="tblproducto.IdMovInventario" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.IdRecinto" class="control-label">Colegio / Recinto</label>
                            <select asp-for="tblproducto.IdRecinto" asp-items="Model.listRecintos" class="form-select">
                                <option value="">— Seleccione colegio / recinto —</option>
                            </select>
                            <span class="text-muted small">Ubicación del inventario (opcional).</span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.IdProveedor" class="control-label">Proveedor</label>
                            <select asp-for="tblproducto.IdProveedor" asp-items="Model.ListaProveedores" class="form-select">
                                <option value="">— Seleccione proveedor —</option>
                            </select>
                            @if (Model.ListaProveedores == null || Model.ListaProveedores.Count == 0)
                            {
                                <span class="text-warning small">No se cargó el catálogo. Reinicie la API y recargue esta página.</span>
                            }
                            else
                            {
                                <span class="text-muted small">Catálogo de proveedores relacionado al producto.</span>
                            }
                        </div>
                            </div>
                <div class="col-lg-4">

                        <div class="form-group">
                            <label asp-for="tblproducto.CostoUnitario" class="control-label">Precio de compra</label>
                            <input type="number" step="0.01" asp-for="tblproducto.CostoUnitario" id="costoUnitario" class="form-control" />
                            <span class="text-muted small">Costo unitario al que se compra el producto.</span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.PrecioVenta" class="control-label">Precio de venta</label>
                            <input type="number" step="0.01" asp-for="tblproducto.PrecioVenta" id="precioVenta" class="form-control" />
                            <span class="text-muted small">Precio al público. Si queda vacío se usa el de compra.</span>
                            @* <span asp-validation-for="tblproducto.CostoUnitario" class="text-danger"></span> *@
                        </div>
                        
            <div class="form-group">
                            <label asp-for="tblproducto.StockActual" class="control-label">Stock actual (solo producto nuevo)</label>
                            <input asp-for="tblproducto.StockActual" id="stockActual" class="form-control" />
                            <span class="text-muted small">En producto nuevo se iguala a la existencia inicial. En ingreso a existente no se usa.</span>
                            <span asp-validation-for="tblproducto.StockActual" class="text-danger"></span>
            </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.StockMinimo" class="control-label">Stock mínimo</label>
                            <input asp-for="tblproducto.StockMinimo" id="stockMinimo" class="form-control" value="@(Model.tblproducto?.StockMinimo > 0 ? Model.tblproducto.StockMinimo : 10)" />
                            <span class="text-muted small">Si el stock actual llega a este valor (mínimo 10) se alerta para reponer inventario.</span>
                            <span asp-validation-for="tblproducto.StockMinimo" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="tblproducto.ImporteInventario" class="control-label">Importe de Inventario</label>
                            <input asp-for="tblproducto.ImporteInventario" id="importeInventario" class="form-control" readonly />
                            
                        </div>
                        
                    </div>
                        @* <div class="col-lg-4"> *@
                        

                    </div>

                    <br />
                    <!-- Botones -->
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    <button type="button" id="btnLimpiar" class="btn btn-warning">
                        <i class="bi bi-trash3"></i> Limpiar Campos
                    </button>
                    </div>

        </form>
        </div>
    </div>
</div>
@* </div> *@


@* <div>
    <a asp-action="Index">Back to List</a>
</div> *@

@section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
        <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
	<script src="~/js/limpiarcampos.js"></script>
        <script src="~/seewtalert/sweetalert.all.min.js"></script>
        <script src="~/seewtalert/sweetalertstyle.js"></script>
        <link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
        function esModoExistente() {
            return $('#modoExistente').is(':checked');
        }

        function generarCodigoNuevo() {
            if (esModoExistente()) return;
            const nombre = ($('#NombreProducto').val() || '').trim().toUpperCase();
            const numero = $('#siguienteNumero').val() || '';
            if (!nombre) {
                $('#CodigoProducto').val(numero);
                return;
            }
            const sinAcentos = nombre.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const palabras = sinAcentos.split(' ').filter(function (p) { return p.length > 0; });
            let codigoBase = palabras.length >= 2
                ? palabras[0].substring(0, 3) + palabras[1].substring(0, 3)
                : palabras[0].substring(0, 6);
            $('#CodigoProducto').val(codigoBase.toUpperCase() + '-' + numero);
        }

        function aplicarModo() {
            const existente = esModoExistente();
            $('#panelBuscar').toggle(existente);
            $('#CodigoProducto').prop('readonly', existente);
            $('#NombreProducto').prop('readonly', existente);
            $('#tblproducto_IdCateProducto').prop('disabled', existente);
            $('#stockActual').prop('readonly', existente);
            if (existente) {
                $('#existenciaInicial').val('');
                $('#avisoExistente').hide();
            } else {
                $('#buscarProducto').val('');
                $('#avisoExistente').hide().text('');
                $('#CodigoProducto').val($('#siguienteNumero').val());
                $('#NombreProducto').val('').prop('readonly', false);
                $('#tblproducto_IdCateProducto').prop('disabled', false);
                $('#stockActual').val('0').prop('readonly', false);
                $('#stockMinimo').val('10');
                $('#existenciaInicial').val('0');
                $('#costoUnitario').val('0');
                $('#precioVenta').val('0');
                $('#importeInventario').val('0.00');
            }
        }

        function calcularImporteInventario() {
            var existenciaInicial = parseFloat($('#existenciaInicial').val()) || 0;
            var stockActual = parseFloat($('#stockActual').val()) || 0;
            var costoUnitario = parseFloat($('#costoUnitario').val()) || 0;
            var cantidad = esModoExistente()
                ? existenciaInicial
                : (stockActual > 0 ? stockActual : existenciaInicial);
            $('#importeInventario').val((cantidad * costoUnitario).toFixed(2));
        }

        $(document).ready(function () {
            $('#NombreProducto').on('change', generarCodigoNuevo);
            $('input[name="modoInventario"]').on('change', aplicarModo);
            $('#costoUnitario, #stockActual, #existenciaInicial').on('input', calcularImporteInventario);
            $('#existenciaInicial').on('change', function () {
                if (!esModoExistente()) {
                    var ex = $(this).val();
                    if (ex) $('#stockActual').val(ex);
                }
                calcularImporteInventario();
            });

            $('#buscarProducto').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("Buscar", "Productos")',
                        data: { q: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    label: item.label,
                                    value: item.label,
                                    codigo: item.codigo,
                                    nombre: item.nombre,
                                    idCategoria: item.idCategoria,
                                    idRecinto: item.idRecinto,
                                    idMovimiento: item.idMovimiento,
                                    idProveedor: item.idProveedor,
                                    costo: item.costo,
                                    precioVenta: item.precioVenta,
                                    stock: item.stock,
                                    stockMinimo: item.stockMinimo
                                };
                            }));
                        },
                        error: function () { response([]); }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    $('#CodigoProducto').val(ui.item.codigo);
                    $('#NombreProducto').val(ui.item.nombre);
                    if (ui.item.idCategoria)
                        $('#tblproducto_IdCateProducto').val(String(ui.item.idCategoria));
                    if (ui.item.idRecinto)
                        $('#tblproducto_IdRecinto').val(String(ui.item.idRecinto));
                    if (ui.item.idMovimiento)
                        $('#tblproducto_IdMovInventario').val(String(ui.item.idMovimiento));
                    $('#costoUnitario').val(ui.item.costo);
                    $('#precioVenta').val(ui.item.precioVenta || ui.item.costo);
                    $('#stockActual').val(ui.item.stock);
                    if (ui.item.stockMinimo)
                        $('#stockMinimo').val(ui.item.stockMinimo);
                    if (ui.item.idProveedor)
                        $('#tblproducto_IdProveedor').val(String(ui.item.idProveedor));
                    $('#existenciaInicial').val('').focus();
                    var aviso = 'Producto encontrado. Stock actual: ' + ui.item.stock +
                        '. Escriba solo la cantidad que ingresa (se sumará). No cambie el código.';
                    if (ui.item.stockMinimo && ui.item.stock <= ui.item.stockMinimo)
                        aviso += ' Atención: está en o bajo el stock mínimo (' + ui.item.stockMinimo + ').';
                    $('#avisoExistente').show().text(aviso);
                    calcularImporteInventario();
                }
            });

            $('#btnLimpiar').on('click', function () {
                setTimeout(function () {
                    $('#modoNuevo').prop('checked', true);
                    aplicarModo();
                }, 0);
            });

            $('form').on('submit', function () {
                $('#tblproducto_IdCateProducto').prop('disabled', false);
            });

            calcularImporteInventario();
        });
    </script>
    
  
    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
                Swal.fire({
                    title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
     TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
     "Información")',
                    text: mensaje,
                    icon: '@TempData["Tipo"]',
                    confirmButtonText: 'Aceptar'
                });
            });
        </script>
    }
}
