@model WebColegio.Models.ViewModel.productoViewModel

<div class="container mt-6">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar producto / inventario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="tblproducto.IdProducto" />
                <input type="hidden" asp-for="tblproducto.UsuarioRegistro" />
                @* FechaRegistro se mantiene en el servidor al fusionar con GET; oculto en POST suele invalidar ModelState *@
                <div class="row">
                    <div class="col-lg-4">
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.CodigoBarra" class="control-label">Código de producto</label>
                            <input asp-for="tblproducto.CodigoBarra" id="CodigoProducto" class="form-control" />
                            <span asp-validation-for="tblproducto.CodigoBarra" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.NombreProducto" class="control-label">Nombre del producto</label>
                            <input asp-for="tblproducto.NombreProducto" id="NombreProducto" class="form-control text-uppercase" />
                            <span asp-validation-for="tblproducto.NombreProducto" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.Descripcion" class="control-label">Descripción</label>
                            <textarea asp-for="tblproducto.Descripcion" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="tblproducto.Descripcion" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.IdCateProducto" class="control-label">Categoría</label>
                            <select asp-for="tblproducto.IdCateProducto" asp-items="Model.listCategoriaProducto" class="form-select" required>
                            </select>
                            <span asp-validation-for="tblproducto.IdCateProducto" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.IdMovInventario" class="control-label">Tipo de movimiento</label>
                            <select asp-for="tblproducto.IdMovInventario" asp-items="Model.listMovimientoInventario" class="form-select" required>
                            </select>
                            <span asp-validation-for="tblproducto.IdMovInventario" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.IdRecinto" class="control-label">Colegio / Recinto</label>
                            <select asp-for="tblproducto.IdRecinto" asp-items="Model.listRecintos" class="form-select">
                                <option value="">— Seleccione colegio / recinto —</option>
                            </select>
                            <span class="text-muted small">Ubicación del inventario (opcional).</span>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.ExistenciaInicial" class="control-label">Existencia inicial (histórico)</label>
                            <input asp-for="tblproducto.ExistenciaInicial" id="existenciaInicial" class="form-control" />
                            <span asp-validation-for="tblproducto.ExistenciaInicial" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.StockActual" class="control-label">Stock actual</label>
                            <input asp-for="tblproducto.StockActual" id="stockActual" class="form-control" />
                            <span asp-validation-for="tblproducto.StockActual" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.StockMinimo" class="control-label">Stock mínimo</label>
                            <input asp-for="tblproducto.StockMinimo" id="stockMinimo" class="form-control" />
                            <span class="text-muted small">Por defecto 10. Al llegar a este valor se alerta para reponer inventario.</span>
                            <span asp-validation-for="tblproducto.StockMinimo" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.CostoUnitario" class="control-label">Precio de compra</label>
                            <input type="number" step="0.01" asp-for="tblproducto.CostoUnitario" id="costoUnitario" class="form-control" />
                            <span class="text-muted small">Costo unitario real. Al guardar se actualiza en la base de datos. El importe es stock × este valor (no es el precio de venta).</span>
                            <span asp-validation-for="tblproducto.CostoUnitario" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.PrecioVenta" class="control-label">Precio de venta</label>
                            <input type="number" step="0.01" asp-for="tblproducto.PrecioVenta" id="precioVenta" class="form-control" />
                            <span class="text-muted small">Precio al público en caja. Se mantiene al modificar el precio de compra.</span>
                            <span asp-validation-for="tblproducto.PrecioVenta" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.ImporteInventario" class="control-label">Importe de inventario</label>
                            <input asp-for="tblproducto.ImporteInventario" id="importeInventario" class="form-control" readonly />
                            <span class="text-muted small">Stock actual × precio de compra. No es el precio unitario de venta.</span>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.IdProveedor" class="control-label">Proveedor</label>
                            <select asp-for="tblproducto.IdProveedor" asp-items="Model.ListaProveedores" class="form-select">
                                <option value="">— Seleccione proveedor —</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Alerta de inventario</label>
                            @if (WebColegio.Helpers.InventarioAlertaHelper.EstaBajoMinimo(Model.tblproducto))
                            {
                                <div class="alert alert-warning py-2 mb-0">
                                    Stock actual (@Model.tblproducto.StockActual) en o bajo el mínimo
                                    (@WebColegio.Helpers.InventarioAlertaHelper.StockMinimoEfectivo(Model.tblproducto.StockMinimo)).
                                    Reponer inventario.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success py-2 mb-0">
                                    Stock suficiente. Se alerta al llegar a
                                    @WebColegio.Helpers.InventarioAlertaHelper.StockMinimoEfectivo(Model.tblproducto.StockMinimo) unidades.
                                </div>
                            }
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="tblproducto.Activo" class="control-label">Estado</label>
                            <select asp-for="tblproducto.Activo" class="form-select">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar cambios
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al listado
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/seewtalert/sweetalert.all.min.js"></script>
    <script src="~/seewtalert/sweetalertstyle.js"></script>
    <link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function calcularImporteInventario() {
            var stockActual = parseFloat($("#stockActual").val()) || 0;
            var costoUnitario = parseFloat($("#costoUnitario").val()) || 0;
            var importe = stockActual * costoUnitario;
            $("#importeInventario").val(importe.toFixed(2));
        }
        $(document).ready(function () {
            $("#costoUnitario, #stockActual").on("input", calcularImporteInventario);
            calcularImporteInventario();
        });
    </script>
    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
                Swal.fire({
                    title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
                        TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
                        "Información")',
                    text: mensaje,
                    icon: '@TempData["Tipo"]',
                    confirmButtonText: 'Aceptar'
                });
            });
        </script>
    }
}
