@model WebColegio.Models.ViewModel.EstadoCuentaViewModel
@using System.Globalization
@{
	ViewData["Title"] = "Estado de Cuenta";
	var colsMes = 12;
	var cultMes = CultureInfo.GetCultureInfo("es-NI");
	string Exp(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="container-fluid p-1" style="padding:2px;">
	<div class="card shadow-lg p-3 mb-5 bg-white rounded">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Estado de cuenta por alumno</h5>
		</div>

		<div class="card-body">
			@* @if (!string.IsNullOrEmpty(Model.MensajePeriodo))
			{
				<p class="text-muted small mb-2">@Model.MensajePeriodo</p>
			}
			@if (Model.Filas == null || !Model.Filas.Any())
			{
				<div class="alert alert-warning">No hay alumnos activos para listar.</div>
			} *@

			<div class="table-responsive" style="font-size:12px">
				<div class="col-12 text-end mb-2">
					<div class="btn-group">
						<button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Agregar pagos / reportes</button>
						<ul class="dropdown-menu">
							<li><a class="dropdown-item" asp-action="Create" asp-controller="Pagos">Agregar pago de mensualidad</a></li>
							<li><a class="dropdown-item" asp-action="Create" asp-controller="PagoCaja">Agregar pagos varios</a></li>
							<li><a class="dropdown-item" asp-action="Index" asp-controller="Pagos">Reporte de pagos</a></li>
						</ul>
					</div>
				</div>

				<table id="estadocuenta" class="table table-bordered table-sm table-hover">
					<thead class="table-light">
						<tr>
							<th>Alumno</th>
							<th>Grado</th>
							<th>Año lectivo</th>
							<th>Colegio</th>
							<th class="text-center" title="Muestra hasta qué mes del año lectivo tiene pagada la mensualidad. Insolvente si debe meses anteriores al mes calendario actual.">Estado pago</th>
							<th class="text-end">Tarifa mensual</th>
							<th class="text-end" title="Tarifa de matrícula del catálogo (recinto, modalidad y período lectivo actual)">Matrícula</th>
							<th class="text-center">Rifa 1</th>
							<th class="text-center">Rifa 2</th>
							<th class="text-center">Promoción</th>
							@for (int m = 1; m <= colsMes; m++)
							{
								<th class="text-end" style="min-width:72px" title="@cultMes.DateTimeFormat.GetMonthName(m)">@cultMes.DateTimeFormat.GetAbbreviatedMonthName(m)</th>
							}
							<th class="text-end">Subtotal mensualidades</th>
							<th class="text-end">Total pendiente</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var fila in Model.Filas ?? Enumerable.Empty<WebColegio.Models.ViewModel.EstadoCuentaFilaAlumno>())
						{
							if (fila.DatosIncompletos)
							{
								<tr class="table-warning">
									<td><strong>@fila.NombreCompleto</strong> — @fila.MotivoIncompleto</td>
									<td>—</td>
									<td>—</td>
									<td>—</td>
									<td class="text-center">—</td>
									<td>—</td>
									<td>—</td>
									<td>—</td>
									<td>—</td>
									<td>—</td>
									@for (int m = 0; m < colsMes; m++)
									{
										<td>—</td>
									}
									<td>—</td>
									<td>—</td>
								</tr>
							}
							else
							{
							<tr>
								<td data-order="@(fila.IdPagoParaEnlace ?? 0)">
									@if (fila.IdPagoParaEnlace.HasValue)
									{
										<a class="btn btn-sm btn-info" asp-action="Edit" asp-controller="Pagos" asp-route-id="@fila.IdPagoParaEnlace.Value">@fila.NombreCompleto</a>
									}
									else
									{
										<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-controller="Alumnos" asp-route-id="@fila.IdAlumno">@fila.NombreCompleto</a>
									}
								</td>
								<td>@(fila.NombreGrado ?? "—")</td>
								<td>@fila.AnioPeriodo</td>
								<td>
									@(fila.Recinto ?? "—")
									@if (!string.IsNullOrWhiteSpace(fila.EtiquetaRecinto))
									{
										<span class="badge @(fila.EsHistorialTraslado ? "bg-secondary" : "bg-primary") ms-1">@fila.EtiquetaRecinto</span>
									}
								</td>
								@{
									string? tooltipEstado = null;
									if (fila.EstadoPagoMensualidad == "Solvente" && !string.IsNullOrEmpty(fila.NombreUltimoMesPagado))
										tooltipEstado = $"Pagado hasta {fila.NombreUltimoMesPagado}";
									else if (fila.EstadoPagoMensualidad == "Insolvente")
									{
										if (!string.IsNullOrEmpty(fila.NombreUltimoMesPagado))
											tooltipEstado = $"Pagado hasta {fila.NombreUltimoMesPagado}";
										if (!string.IsNullOrEmpty(fila.MesesPendientesSolvencia))
											tooltipEstado = string.IsNullOrEmpty(tooltipEstado)
												? $"Debe: {fila.MesesPendientesSolvencia}"
												: $"{tooltipEstado} · Debe: {fila.MesesPendientesSolvencia}";
									}
								}
								<td class="text-center col-estado-pago" title="@tooltipEstado">
									@if (string.IsNullOrEmpty(fila.EstadoPagoMensualidad) || fila.EstadoPagoMensualidad == "N/D")
									{
										<span class="text-muted">—</span>
									}
									else if (fila.EstadoPagoMensualidad == "Solvente")
									{
										<span class="estado-pago-texto text-success fw-semibold">Solvente</span>
									}
									else
									{
										<span class="estado-pago-texto text-danger fw-semibold">Endeudado</span>
									}
								</td>
								<td class="text-end" data-export="@(fila.SinTarifaMensualidad ? "" : Exp(fila.MensualidadReferencia))">
									@if (fila.SinTarifaMensualidad)
									{
										<span class="badge bg-secondary">Sin tarifa en catálogo</span>
									}
									else
									{
										<text>C$ @fila.MensualidadReferencia.ToString("N2")</text>
									}
								</td>
								<td class="text-end @(fila.MatriculaCancelada ? "table-success" : "")" data-export="@(fila.MatriculaReferencia <= 0 ? "" : Exp(fila.MatriculaCancelada ? 0 : fila.SaldoMatricula))" title="@(fila.MatriculaReferencia > 0 ? $"Tarifa C$ {fila.MatriculaReferencia:N2} · Abonado C$ {fila.TotalPagadoMatricula:N2}" : "")">
									@if (fila.MatriculaReferencia <= 0)
									{
										<span class="text-muted">—</span>
									}
									else
									{
										<text>C$ @((fila.MatriculaCancelada ? 0m : fila.SaldoMatricula).ToString("N2"))</text>
									}
								</td>
								<td class="text-end @(fila.MontoRifaSemestre1 > 0.01m ? "table-success" : "")" data-export="@(fila.MontoRifaSemestre1 > 0.01m ? Exp(fila.MontoRifaSemestre1) : "")">
									@if (fila.MontoRifaSemestre1 > 0.01m)
									{
										<text>C$ @fila.MontoRifaSemestre1.ToString("N2")</text>
									}
									else
									{
										<span class="text-muted">—</span>
									}
								</td>
								<td class="text-end @(fila.MontoRifaSemestre2 > 0.01m ? "table-success" : "")" data-export="@(fila.MontoRifaSemestre2 > 0.01m ? Exp(fila.MontoRifaSemestre2) : "")">
									@if (fila.MontoRifaSemestre2 > 0.01m)
									{
										<text>C$ @fila.MontoRifaSemestre2.ToString("N2")</text>
									}
									else
									{
										<span class="text-muted">—</span>
									}
								</td>
								<td class="text-end @(fila.MontoPromocion > 0.01m ? "table-success" : "")" data-export="@(fila.MontoPromocion > 0.01m ? Exp(fila.MontoPromocion) : "")">
									@if (fila.MontoPromocion > 0.01m)
									{
										<text>C$ @fila.MontoPromocion.ToString("N2")</text>
									}
									else
									{
										<span class="text-muted" title="@(fila.AplicaPromocion ? "" : "Solo 3er nivel, 6.° y 11.°")">—</span>
									}
								</td>
								@foreach (var cel in fila.Meses ?? Array.Empty<WebColegio.Models.ViewModel.EstadoCuentaMesCelda>())
								{
									var titulo = $"Tarifa C$ {cel.MontoEsperado:N2} · Pagado C$ {cel.MontoPagado:N2}";
									if (cel.NoCorresponde)
									{
										<td class="text-center text-muted" data-export="" title="No corresponde: ingreso por traslado en un mes posterior">—</td>
									}
									else if (cel.Cancelado)
									{
										<td class="table-success text-end" data-export="0" title="@titulo">C$ 0,00</td>
									}
									else if (cel.TieneAbonoParcial)
									{
										<td class="table-warning text-end" data-export="@Exp(cel.Saldo)" title="@titulo">C$ @cel.Saldo.ToString("N2")</td>
									}
									else
									{
										<td class="text-end table-danger" data-export="@Exp(cel.Saldo)" title="@titulo">C$ @cel.Saldo.ToString("N2")</td>
									}
								}
								<td class="text-end fw-semibold" data-export="@Exp(fila.TotalSaldoMensualidades)">C$ @fila.TotalSaldoMensualidades.ToString("N2")</td>
								<td class="text-end fw-bold" data-export="@Exp(fila.GranTotalPendiente)">C$ @fila.GranTotalPendiente.ToString("N2")</td>
							</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
	<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
	<script>
		$(document).ready(function () {
			if ($.fn.DataTable.isDataTable('#estadocuenta')) {
				$('#estadocuenta').DataTable().destroy();
			}
			function textoCeldaExport(data) {
				return $('<div>').html(data).text().replace(/\s+/g, ' ').trim();
			}
			function valorExcel(data, node) {
				var texto = '';
				if (node) {
					var attr = node.getAttribute('data-export');
					if (attr !== null)
						texto = String(attr).trim();
					else
						texto = textoCeldaExport(data);
				} else {
					texto = textoCeldaExport(data);
				}
				if (!texto || texto === '—' || texto === '-' || /^(pagado|pendiente)$/i.test(texto))
					return '';
				var match = texto.replace(/C\$/gi, '').match(/-?\d+[.,]?\d*/);
				if (match) {
					var n = parseFloat(match[0].replace(',', '.'));
					if (!isNaN(n))
						return n;
				}
				return texto;
			}

			$('#estadocuenta').DataTable({
				responsive: false,
				scrollX: true,
				pageLength: 10,
				lengthMenu: [[5, 10, 20], [5, 10, 20]],
				paging: true,
				order: [[0, 'desc']],
				dom: 'Blfrtip',
				buttons: [
					{
						extend: 'excelHtml5',
						text: 'Exportar a Excel',
						className: 'btn btn-success btn-sm',
						title: 'Estado de cuenta',
						exportOptions: {
							columns: ':visible',
							modifier: { search: 'applied', order: 'applied' },
							format: {
								body: function (data, row, column, node) { return valorExcel(data, node); }
							}
						}
					}
				],
				language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
				columnDefs: [
					{
						targets: 4,
						render: function (data, type) {
							if (type === 'filter' || type === 'sort' || type === 'export') {
								return textoCeldaExport(data);
							}
							return data;
						}
					}
				]
			});
		});
	</script>
}
