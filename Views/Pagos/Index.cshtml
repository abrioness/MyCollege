@model WebColegio.Models.ViewModel.ColeccionCatalogos

@* @{

	ViewData["Title"] = "Index";

} *@

@{
	var puedeAnularRecibo = User.IsInRole("Admin") || User.IsInRole("UserSystem");
}

<div class="container mt-auto" style="padding:2px;">

	<div class="card shadow-lg p-3 mb-5 bg-white rounded">

		<div class="card-header bg-primary text-white">



			<h5 class="mb-0"><i class="bi bi-cash-coin"></i>  Reporte de Caja (matrículas y mensualidades)</h5>



		</div>



		<div class="card-body">


			<div class="table-responsive" style="font-size:12px">

				<div class="col-4 text-center">

					@using (Html.BeginForm("Index", "Pagos", FormMethod.Get))

					{

						<div class="row">

							<div class="col-4">

								<label class="control-label">Desde:</label>

								<input type="date" name="fechainicio" id="FechaInicio" class="form-control"

									   value="@Context.Request.Query["fechainicio"]" />

							</div>

							<div class="col-4">

								<label class="control-label">Hasta:</label>

								<input type="date" name="fechafin" id="FechaFin" class="form-control"

									   value="@Context.Request.Query["fechafin"]" />

							</div>

							<div class="col-4">

								<br />

								<button type="submit" class="form-control btn btn-success">Filtrar</button>

							</div>

						</div>

					}

				</div>



				<div class="col-12 text-end">



					<a asp-action="Create" class="btn btn-primary">

						<i class="bi bi-plus-circle"></i> Agregar Pago

					</a>

				</div>

				<br />

				@if (ViewBag.FiltroFechaActivo == true && ViewBag.TotalPagosMostrados != ViewBag.TotalPagosApi)

				{

					<div class="alert alert-info py-2">

						Filtro de fechas activo: se muestran @ViewBag.TotalPagosMostrados de @ViewBag.TotalPagosApi pagos.

						<a asp-action="Index" asp-controller="Pagos" class="alert-link">Quitar filtro</a>

					</div>

				}

				<table id="tablaPagos" class="table table-bordered table-sm">

					@* class="display responsive nowrap" style="width:100%"> *@

					<thead>

						<tr>

							<th>Número Recibo</th>

							<th>Alumno</th>

							<th>Concepto</th>

							<th>Monto</th>

							<th>Mora</th>

							<th>Mes Pagado</th>						

							<th>Tipo Recibo</th>

							<th>Colegio</th>

							<th>Fecha Emisión</th>
							<th>Cajero</th>
							<th>Estado</th>
							@if (puedeAnularRecibo)
							{
								<th>Acciones</th>
							}

						</tr>

					</thead>

					<tbody>

						@foreach (var itemPago in Model.pagos)

						{

							<tr class="@(itemPago.Activo ? "" : "table-secondary")">

								<td data-order="@itemPago.IdPago"><a asp-action="Details" asp-controller="Pagos" asp-route-id="@itemPago.IdPago" class="btn btn-sm btn-info" target="_blank">	@itemPago.NumeroRecibo</a></td>



								@{

									var alumno = Model.alumno.FirstOrDefault(a => a.IdAlumno == itemPago.IdAlumno);

								}	

								<td>

									@(alumno != null ? $"{alumno.Nombre} {alumno.Apellido}".Trim() : $"Alumno #{itemPago.IdAlumno}")

								</td>





								@{

									var tipoMovimiento = Model.tipoMovimiento.FirstOrDefault(a => a.IdTipoMovimiento == itemPago.IdTipoMovimiento);

								}

								<td>



									@tipoMovimiento?.Concepto



								</td>



								<td>



									C$ @itemPago.Monto

								</td>

								<td>



									C$	@((itemPago.Mora== null) ? "0" : itemPago.Mora)

								</td>

								@if (itemPago.IdMes == null)

								{

									<td>

										@if (itemPago.IdTipoMovimiento == 2 || itemPago.IdTipoMovimiento == 4)

										{

											<span>Matrícula (+ enero)@(itemPago.Continuidad ? ", continuidad" : "")</span>

										}

									</td>

								}

								else

								{

									

								var mesPagar = Model.meses.FirstOrDefault(a => a.IdMes == itemPago.IdMes);



									

									<td>

										@mesPagar?.Mes

									</td>



								}





								@{

									var tipoRecibo = Model.tipoRecibo.FirstOrDefault(a => a.IdTipoRecibo == itemPago.IdTipoRecibo);

								}

								<td>



									@tipoRecibo?.TipoRecibo



								</td>



								@{

									var recinto = Model.recintos.FirstOrDefault(a => a.IdRecinto == itemPago.IdRecinto);

								}

								<td>



									@recinto?.Recinto



								</td>

							



							 <td>

								@itemPago.FechaRegistro.ToString("dd/MM/yyyy")

						</td>
							<td>
								@{
									var cajero = Model.usuarios?.FirstOrDefault(u => u.IdUsuario == itemPago.UsuarioRegistro);
									var nombreCajero = !string.IsNullOrWhiteSpace(cajero?.NombreCompleto)
										? cajero.NombreCompleto
										: (cajero?.NombreUsuario ?? "—");
								}
								@nombreCajero
							</td>
							<td>
								@if (itemPago.Activo)
								{
									<span class="badge bg-success">Activo</span>
								}
								else
								{
									<span class="badge bg-secondary">Anulado</span>
								}
							</td>
							@if (puedeAnularRecibo)
							{
								<td>
									@if (itemPago.Activo)
									{
										<form asp-action="AnularRecibo" asp-controller="Pagos" method="post" class="d-inline js-anular-recibo"
											  data-mensaje="¿Anular el recibo @itemPago.NumeroRecibo? Esta acción anulará todas las líneas del mismo recibo.">
											@Html.AntiForgeryToken()
											<input type="hidden" name="id" value="@itemPago.IdPago" />
											<input type="hidden" name="fechainicio" value="@Context.Request.Query["fechainicio"]" />
											<input type="hidden" name="fechafin" value="@Context.Request.Query["fechafin"]" />
											<button type="submit" class="btn btn-sm btn-outline-danger" title="Anular recibo">
												<i class="bi bi-x-circle"></i> Anular
											</button>
										</form>
									}
									else
									{
										<span class="text-muted small">—</span>
									}
								</td>
							}

							@*<td>

								<a asp-action="Details" asp-controller="Notas" asp-route-id="@itemNotas.IdNota" class="btn btn-sm btn-warning"><i class="bi bi-journal-richtext"></i></a>

							</td>*@

						</tr>

					}

				</tbody>



			</table>

		</div>

		</div>

	</div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

	$(document).on("submit", "form.js-anular-recibo", function (e) {
		e.preventDefault();
		var form = this;
		var mensaje = form.getAttribute("data-mensaje") || "¿Anular el recibo?";
		if (typeof Swal === "undefined") {
			if (window.confirm(mensaje)) form.submit();
			return;
		}
		Swal.fire({
			title: "Atención",
			text: mensaje,
			icon: "warning",
			showCancelButton: true,
			confirmButtonText: "Aceptar",
			cancelButtonText: "Cancelar"
		}).then(function (result) {
			if (result.isConfirmed) form.submit();
		});
	});

	$(document).ready(function () {

		if (!$.fn.DataTable) return;

		var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");

		var botones = esCajero ? [] : [

			{

				extend: 'excelHtml5',

				text: 'Exportar a Excel',

				className: 'btn btn-success'

			}

		];

		if ($('#tablaPagos tbody tr').length) {

			$('#tablaPagos').DataTable({

				responsive: false,

				pageLength: 10,

				lengthMenu: [[5, 10, 20], [5, 10, 20]],

				paging: true,

				order: [[0, 'desc']],

				dom: esCajero ? 'lfrtip' : 'Blfrtip',

				buttons: botones,

				language: {

					url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"

				}

			});

		}

	});

</script>
@if (TempData["Mensaje"] != null)
{
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
			var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
			Swal.fire({
				title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
				text: mensaje,
				icon: tipo,
				confirmButtonText: "Aceptar"
			});
		});
	</script>
}

}


