@model WebColegio.Models.ViewModel.TrasladoViewModel
@{
    ViewData["Title"] = "Traslado entre colegios";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-arrow-left-right"></i> Traslado entre colegios</h4>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                El traslado se hace <strong>después de que el alumno ya está matriculado</strong> en el colegio de origen.
                No se da de baja ni se crea otra ficha: se actualiza el mismo registro al colegio destino.
                Se cobran la <strong>matrícula del destino</strong> y la <strong>mensualidad desde el mes de ingreso</strong>
                (ese mes y los siguientes). Los meses anteriores no se cobran en el destino.
            </p>

            <form asp-action="Traslado" method="post" id="formTraslado">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdAlumno" id="IdAlumno" />
                <input type="hidden" asp-for="IdRecintoOrigen" />
                <input type="hidden" asp-for="IdPeriodo" />
                <input type="hidden" asp-for="NombreAlumno" id="NombreAlumnoHidden" />
                <input type="hidden" asp-for="NombreRecintoOrigen" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Alumno</label>
                            <input type="text" id="AlumnoNombre" class="form-control" placeholder="Buscar por nombre o apellido..." value="@Model.NombreAlumno" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Colegio actual</label>
                            <input class="form-control" id="txtColegioOrigen" value="@Model.NombreRecintoOrigen" readonly />
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="IdRecintoDestino" class="form-label">Colegio destino</label>
                            <select asp-for="IdRecintoDestino" id="idRecintoDestino" asp-items="Model.RecintosDestino" class="form-select" required>
                                <option value="">Seleccione el colegio destino</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="IdGrado" class="form-label">Nivel</label>
                            <select asp-for="IdGrado" id="idGrado" asp-items="Model.Grados" class="form-select" required>
                                @if (Model.IdGrado <= 0)
                                {
                                    <option value="">Seleccione el nivel</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="IdModalidad" class="form-label">Modalidad</label>
                            <select asp-for="IdModalidad" id="idModalidad" asp-items="Model.Modalidades" class="form-select" required>
                                @if (!Model.IdModalidad.HasValue || Model.IdModalidad.Value <= 0)
                                {
                                    <option value="">Seleccione la modalidad</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="FechaTraslado" class="form-label">Fecha de traslado</label>
                            <input asp-for="FechaTraslado" id="fechaTraslado" type="date" class="form-control"
                                   value="@(Model.FechaTraslado is { Year: > 2000 } ft ? ft.ToString("yyyy-MM-dd") : "")" required />
                            <small class="text-muted">Indique el día en que ingresa al destino. Ese mes es el primero a cobrar; no se usa la fecha de hoy.</small>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="MesIngreso" class="form-label">Mes de ingreso al colegio destino</label>
                            <select asp-for="MesIngreso" id="mesIngreso" class="form-select" required>
                                @{
                                    var cultMes = System.Globalization.CultureInfo.GetCultureInfo("es-NI");
                                    int mesSel = Model.MesIngreso is >= 1 and <= 12 ? Model.MesIngreso : 0;
                                }
                                <option value="">Seleccione el mes</option>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    if (m == mesSel)
                                    {
                                        <option value="@m" selected>@cultMes.DateTimeFormat.GetMonthName(m)</option>
                                    }
                                    else
                                    {
                                        <option value="@m">@cultMes.DateTimeFormat.GetMonthName(m)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="alert alert-info mb-0">
                            <div>Mensualidad destino: <strong id="txtTarifaDestino">C$ @Model.TarifaDestino.ToString("N2")</strong></div>
                            <div>Matrícula destino: <strong id="txtMatricula">C$ @((Model.MatriculaNeta > 0 ? Model.MatriculaNeta : Model.MontoMatricula).ToString("N2"))</strong>
                                <span id="lblCobraMatricula">@(Model.CobraMatricula ? "(se cobra)" : "")</span>
                            </div>
                            <div class="mt-1">Total a cobrar: <strong id="txtTotalCobrar">C$ @Model.TotalACobrar.ToString("N2")</strong></div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-sm table-bordered" id="tablaMesesTraslado">
                        <thead class="table-light">
                            <tr>
                                <th>Concepto</th>
                                <th class="text-end">Tarifa destino</th>
                                <th>Estado</th>
                                <th class="text-end">A cobrar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                decimal tarifaMatFila = Model.MatriculaNeta > 0 ? Model.MatriculaNeta : Model.MontoMatricula;
                                decimal cobrarMatFila = Model.CobraMatricula ? Model.SaldoMatricula : 0m;
                            }
                            <tr class="table-primary" id="filaMatriculaTraslado">
                                <td>Matrícula destino</td>
                                <td class="text-end">C$ @tarifaMatFila.ToString("N2")</td>
                                <td>
                                    @if (Model.IdRecintoDestino <= 0)
                                    {
                                        <span class="text-muted">Seleccione el colegio destino</span>
                                    }
                                    else if (cobrarMatFila > 0)
                                    {
                                        <span class="text-danger">Pendiente en destino</span>
                                    }
                                    else if (tarifaMatFila > 0)
                                    {
                                        <span class="text-success">Ya pagada en destino</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin tarifa de matrícula</span>
                                    }
                                </td>
                                <td class="text-end">C$ @cobrarMatFila.ToString("N2")</td>
                            </tr>
                            @foreach (var mes in Model.Meses)
                            {
                                <tr>
                                    <td>@mes.Nombre</td>
                                    <td class="text-end">C$ @Model.TarifaDestino.ToString("N2")</td>
                                    <td>
                                        @if (mes.NoCorresponde)
                                        {
                                            <span class="text-muted">No corresponde (antes del ingreso)</span>
                                        }
                                        else if (mes.Respetado)
                                        {
                                            <span class="text-success">Ya pagado en destino</span>
                                        }
                                        else if (mes.SaldoACobrar > 0)
                                        {
                                            <span class="text-danger">Pendiente en destino</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin cargo aún</span>
                                        }
                                    </td>
                                    <td class="text-end">C$ @mes.SaldoACobrar.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.Meses.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-muted">Seleccione el alumno, la fecha de traslado y el colegio destino para ver el desglose.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="submit" class="btn btn-primary" id="btnConfirmarTraslado">
                    <i class="bi bi-check2-circle"></i> Confirmar traslado y cobrar pendientes
                </button>
                <a asp-action="Create" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(function () {
        const urlResumen = '@Url.Action("ObtenerResumenTraslado", "Pagos")';
        const urlBuscar = '@Url.Action("Buscar", "Alumnos")';

        $('#AlumnoNombre').autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: urlBuscar,
                    data: { q: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.nombreCompleto, value: item.nombreCompleto, id: item.id };
                        }));
                    },
                    error: function () { response([]); }
                });
            },
            minLength: 2,
            select: function (event, ui) {
                $('#IdAlumno').val(ui.item.id);
                $('#NombreAlumnoHidden').val(ui.item.label);
                cargarResumen();
            }
        });

        $('#idRecintoDestino').on('change', cargarResumen);

        let syncingFecha = false;
        $('#fechaTraslado').on('change', function () {
            if (syncingFecha) return;
            const d = $(this).val();
            if (d && d.length >= 7) {
                const mes = parseInt(d.split('-')[1], 10);
                if (mes >= 1 && mes <= 12) {
                    syncingFecha = true;
                    $('#mesIngreso').val(String(mes));
                    syncingFecha = false;
                }
            }
            cargarResumen();
        });
        $('#mesIngreso').on('change', function () {
            if (syncingFecha) return;
            const mes = parseInt($(this).val(), 10) || 0;
            const fecha = $('#fechaTraslado').val();
            let anio = new Date().getFullYear();
            let dia = 1;
            if (fecha && fecha.length >= 10) {
                const p = fecha.split('-');
                anio = parseInt(p[0], 10) || anio;
                dia = parseInt(p[2], 10) || 1;
            }
            if (mes >= 1 && mes <= 12) {
                const last = new Date(anio, mes, 0).getDate();
                dia = Math.min(Math.max(dia, 1), last);
                syncingFecha = true;
                $('#fechaTraslado').val(anio + '-' + String(mes).padStart(2, '0') + '-' + String(dia).padStart(2, '0'));
                syncingFecha = false;
            }
            cargarResumen();
        });

        function estadoMesHtml(m) {
            if (m.noCorresponde) return '<span class="text-muted">No corresponde (antes del ingreso)</span>';
            if (m.respetado) return '<span class="text-success">Ya pagado en destino</span>';
            if (m.saldoACobrar > 0) return '<span class="text-danger">Pendiente en destino</span>';
            return '<span class="text-muted">Sin cargo aún</span>';
        }

        function filaMatriculaHtml(data) {
            const neta = Number(data.matriculaNeta || data.montoMatricula || 0);
            const saldo = data.cobraMatricula ? Number(data.saldoMatricula || neta || 0) : 0;
            let estado = '<span class="text-muted">Seleccione el colegio destino</span>';
            if (Number(data.tarifaDestino) > 0 || neta > 0) {
                if (saldo > 0.01) estado = '<span class="text-danger">Pendiente en destino</span>';
                else if (neta > 0) estado = '<span class="text-success">Ya pagada en destino</span>';
                else estado = '<span class="text-muted">Sin tarifa de matrícula</span>';
            }
            return '<tr class="table-primary">' +
                '<td>Matrícula destino</td>' +
                '<td class="text-end">C$ ' + neta.toFixed(2) + '</td>' +
                '<td>' + estado + '</td>' +
                '<td class="text-end">C$ ' + saldo.toFixed(2) + '</td></tr>';
        }

        function cargarResumen() {
            const idAlumno = parseInt($('#IdAlumno').val(), 10) || 0;
            const idDestino = parseInt($('#idRecintoDestino').val(), 10) || 0;
            const mesIngreso = parseInt($('#mesIngreso').val(), 10) || 0;
            const fechaTraslado = $('#fechaTraslado').val() || '';
            if (!idAlumno) return;

            $.getJSON(urlResumen, {
                idAlumno: idAlumno,
                idRecintoDestino: idDestino,
                mesIngreso: mesIngreso,
                fechaTraslado: fechaTraslado
            }, function (data) {
                if (!data || !data.ok) return;
                if (data.nombreRecintoOrigen)
                    $('#txtColegioOrigen').val(data.nombreRecintoOrigen);
                if (data.idRecintoOrigen)
                    $('input[name="IdRecintoOrigen"]').val(data.idRecintoOrigen);
                if (data.idPeriodo)
                    $('input[name="IdPeriodo"]').val(data.idPeriodo);
                if (data.idGrado)
                    $('#idGrado').val(String(data.idGrado));
                if (data.idModalidad)
                    $('#idModalidad').val(String(data.idModalidad));
                if (data.recintosDestino && data.recintosDestino.length) {
                    const actual = String(idDestino || '');
                    const $sel = $('#idRecintoDestino');
                    $sel.find('option:not(:first)').remove();
                    data.recintosDestino.forEach(function (r) {
                        $sel.append($('<option>', { value: r.value, text: r.text, selected: String(r.value) === actual }));
                    });
                }
                const neta = Number(data.matriculaNeta || data.montoMatricula || 0);
                $('#txtTarifaDestino').text('C$ ' + Number(data.tarifaDestino).toFixed(2));
                $('#txtMatricula').text('C$ ' + neta.toFixed(2));
                $('#lblCobraMatricula').text(data.cobraMatricula ? '(se cobra)' : '');
                $('#txtTotalCobrar').text('C$ ' + Number(data.totalACobrar).toFixed(2));
                const $tb = $('#tablaMesesTraslado tbody');
                $tb.empty();
                $tb.append(filaMatriculaHtml(data));
                (data.meses || []).forEach(function (m) {
                    $tb.append(
                        '<tr><td>' + m.nombre + '</td>' +
                        '<td class="text-end">C$ ' + Number(m.tarifa || data.tarifaDestino || 0).toFixed(2) + '</td>' +
                        '<td>' + estadoMesHtml(m) + '</td>' +
                        '<td class="text-end">C$ ' + Number(m.saldoACobrar).toFixed(2) + '</td></tr>'
                    );
                });
            });
        }

        $('#formTraslado').on('submit', function (e) {
            if (!(parseInt($('#IdAlumno').val(), 10) > 0)) {
                e.preventDefault();
                Swal.fire({ title: 'Atención', text: 'Busque y seleccione el alumno.', icon: 'warning' });
                return;
            }
            const fecha = $('#fechaTraslado').val() || '';
            const mes = parseInt($('#mesIngreso').val(), 10) || 0;
            if (!fecha || mes < 1 || mes > 12) {
                e.preventDefault();
                Swal.fire({
                    title: 'Atención',
                    text: 'Indique la fecha de traslado. Ese mes es el primero a cobrar en el destino.',
                    icon: 'warning'
                });
                return;
            }
            if (!window._trasladoConfirmado) {
                e.preventDefault();
                const mesNombre = $('#mesIngreso option:selected').text();
                Swal.fire({
                    title: 'Confirmar mes de ingreso',
                    html: 'En el colegio destino se cobrará la matrícula y las mensualidades <strong>desde ' + mesNombre + '</strong>. ' +
                        'Si ahí no hay pagos, no se omiten meses posteriores a esa fecha. Los meses anteriores no corresponden.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Confirmar traslado',
                    cancelButtonText: 'Cambiar fecha'
                }).then(function (res) {
                    if (res.isConfirmed) {
                        window._trasladoConfirmado = true;
                        $('#formTraslado').trigger('submit');
                    }
                });
            }
        });
    });
</script>

@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" : TempData["Tipo"]?.ToString() == "warning" ? "Atención" : "Información")',
                text: @Html.Raw(Json.Serialize(TempData["Mensaje"])),
                icon: '@(TempData["Tipo"]?.ToString() ?? "info")',
                confirmButtonText: 'Aceptar'
            });
        });
    </script>
}
