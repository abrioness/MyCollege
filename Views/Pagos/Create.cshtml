@model WebColegio.Models.ViewModel.PagosViewModel

@{
    ViewData["Title"] = "Create";
    var añoActual = DateTime.Now.Year;
    var añosInicio = añoActual - 3;
    var añosFin = añoActual + 5;
}

<div class="container mt-6">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">

            <h4 class="mb-0"><i class="bi bi-cash-coin"></i> Registro de Recibo de Caja Mensualidades</h4>

        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Pago.NumeroRecibo" class="control-label">Número Recibo</label>
                            <input asp-for="Pago.NumeroRecibo" value="@Model.SiguienteNumero" id="numeroRecibo" class="form-control" readonly />
                            <span asp-validation-for="Pago.NumeroRecibo" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.IdAlumno">Nombre del Alumno</label>
                            <input type="text" id="AlumnoNombre" class="form-control" placeholder="Buscar Alumno..." />
                            <input type="hidden" id="IdAlumno" name="Pago.IdAlumno" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Pago.IdTipoMovimiento" class="control-label">Concepto</label>

                            <select asp-for="Pago.IdTipoMovimiento" id="tipoMovimiento" asp-items="Model.tipoMovimientoSelectListItem" class="form-select" required>
                                <option value="">Seleccione un Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdTipoMovimiento" class="text-danger"
                            data-val-required="Por favor, seleccione el tipo de movimiento"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.IdTipoRecibo" class="control-label">Tipo de Recibo</label>
                            <select asp-for="Pago.IdTipoRecibo" asp-items="Model.tipoRecibosSelectListItem" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdTipoRecibo" class="text-danger"></span>

                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.IdPeriodo" class="control-label">Ciclo Escolar</label>
                            <select asp-for="Pago.IdPeriodo" id="periodo" asp-items="Model.periodo" class="form-select">
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdPeriodo" class="text-danger"></span>

                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.IdRecinto" class="control-label">Centro de Estudio</label>
                            <select asp-for="Pago.IdRecinto" id="recinto" asp-items="Model.recintos" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdRecinto" class="text-danger"></span>
                        </div>
                       
                        
                       @*  <div class="form-group">
                            <label asp-for="Pago.TotalPagar" class="control-label">Total a Pagar</label>
                            <input asp-for="Pago.TotalPagar" id="totalPagar" class="form-control" />
                            <span asp-validation-for="Pago.TotalPagar" class="text-danger"></span>
                        </div> *@
                    </div>
 
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label asp-for="Pago.IdModalidad" class="control-label">Modalidad</label>
                            <select asp-for="Pago.IdModalidad" id="modalidad" asp-items="Model.modalidadSelectListItem" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdModalidad" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.IdGrado" class="control-label">Nivel</label>
                            <select asp-for="Pago.IdGrado" id="grado" asp-items="Model.gradosSelectListItem" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdGrado" class="text-danger"></span>
                        </div>
                       @* <div class="form-group">
                            <label asp-for="Pago.Anyo" class="control-label">Año</label>
                            <select asp-for="Pago.Anyo" id="anyo" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                                @for (int año = añosInicio; año <= añosFin; año++)
                                {
                                    <option value="@año">@año</option>
                                }
                            </select>
                            <span asp-validation-for="Pago.Anyo" class="text-danger"></span>
                        </div> *@
                        <div class="form-group">
                            <label asp-for="Pago.IdMetodoPago" class="control-label">Metodo de Pago</label>
                            <select asp-for="Pago.IdMetodoPago" asp-items="Model.metodoPagoSelectListItem" class="form-select" required>
                                <option value="">Seleccione una Opción</option>
                            </select>
                            <span asp-validation-for="Pago.IdMetodoPago" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="@Html.IdFor(m => m.Pago.FechaEmision)" id="lblFechaEmision" class="control-label js-lbl-fecha-emision">Fecha de pago</label>
                            <input type="date" asp-for="Pago.FechaEmision" pattern="\d{2}/\d{2}/\d{4}" placeholder="dd/mm/yyyy" class="form-control" />
                            <small id="ayudaFechaMatricula" class="text-muted d-block mt-1" style="display: none;">La mensualidad incluida en matrícula completa se registra siempre como <strong>enero</strong>, no según esta fecha.</small>
                            <span asp-validation-for="Pago.FechaEmision" class="text-danger"></span>
                        </div>
                      
                        <div class="form-group">
                            <label asp-for="Pago.Monto" class="control-label">Monto a pagar</label>

                            <input asp-for="Pago.Monto" id="cantidad" class="form-control"  />
                            <span id="mensajemontomatricual" class="text-info fw-bold" style="display: none;"></span>
                        </div>

                        <div class="form-group" id="moraDiv">
                            <label asp-for="Pago.Mora" class="control-label">Mora</label>
                            <input asp-for="Pago.Mora" id="totalMora" class="form-control" />
                            <span asp-validation-for="Pago.Mora" class="text-danger"></span>
                        </div>
                       @*  <div class="form-group">
                            <label asp-for="Pago.TotalPagar" class="control-label">Total a Pagar</label>
                            <input asp-for="Pago.TotalPagar" id="totalPagar" class="form-control"  />
                            <span asp-validation-for="Pago.TotalPagar" class="text-danger"></span>
                        </div> *@
                        <!-- Sección de Meses - Se muestra/oculta según el tipo de movimiento -->
                        <br />
                        <div class="form-group" id="mesPagado">
                            <label>Meses a pagar</label>
                            <div id="mesesSeleccionadosContainer" class="mb-2">
                                <!-- Aquí se mostrarán los meses elegidos -->
                            </div>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalMeses">
                                Seleccionar meses
                            </button>

                            <!-- Campo oculto que enviará los IDs -->
                            <input type="hidden" id="MesesSeleccionados" name="MesesSeleccionados" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Pago.Descripcion" class="control-label">Observaciones</label>
                            <textarea name="Pago.Descripcion" class="form-control"></textarea>
                        </div>
                        <div class="form-check">
                            <input asp-for="Pago.Continuidad" class="form-check-input" />
                            <label asp-for="Pago.Continuidad" class="form-check-label">
                                Es continuidad
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Modal -->
                <div class="modal fade" id="modalMeses" tabindex="-1" aria-labelledby="modalMesesLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Seleccionar meses</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    @if (Model?.meses != null && Model.meses.Any())
                                            {
                                    @foreach (var itemMeses in Model?.meses)
                                    {
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       name="MesesSeleccionados"
                                                       value="@itemMeses.IdMes"
                                                       class="form-check-input" id="mes_@itemMeses.IdMes" />
                                                <label class="form-check-label" for="mes_@itemMeses.IdMes">
                                                    @itemMeses.Mes
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <p class="text-muted">No hay meses disponibles para seleccionar.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                <button type="button" class="btn btn-primary" onclick="confirmarMeses()">Confirmar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <!-- Botones -->
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Procesar Pago
                    </button>
                    @* <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a> *@
                    <button type="button" id="btnLimpiar" class="btn btn-warning">
                        <i class="bi bi-trash3"></i> Limpiar Campos
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/limpiarcampos.js"></script>
    <script>
        $(function() {
            // Rutas respetan PathBase (ej. IIS en /WebColegio); evita 404 en producción con subdirectorio.
            const urlsPagos = {
                buscarAlumnos: '@Url.Action("Buscar", "Alumnos")',
                obtenerAbonosPrevios: '@Url.Action("ObtenerAbonosPrevios", "Pagos")',
                obtenerMensualidad: '@Url.Action("ObtenerMensualidad", "Pagos")',
                obtenerMatricula: '@Url.Action("ObtenerMatricula", "Pagos")',
                obtenerMora: '@Url.Action("ObtenerMora", "Pagos")',
                obtenerDatosAlumnoMatricula: '@Url.Action("ObtenerDatosAlumnoMatricula", "Pagos")'
            };

            // Cachear selectores jQuery (tras DOM listo; evita etiquetas vacías si el script corre antes del formulario)
            const $tipoMovimiento = $('#tipoMovimiento');
            const $mesPagado = $('#mesPagado');
            const $alumnoNombre = $('#AlumnoNombre');
            const $idAlumno = $('#IdAlumno');
            const $recinto = $('#recinto');
            const $grado = $('#grado');
            const $periodo = $('#periodo');
            const $monto = $('#cantidad');
            const $mensajeMontoMatricula=$('#mensajemontomatricual')
            const $totalMora = $('#totalMora');
            const $totalPagar = $('#totalPagar');
            const $moraDiv=$('#moraDiv');
            const $modalidad = $('#modalidad');
            const $anyo = $('#anyo');

            // Constantes para tipos de movimiento
            const TIPO_MENSUALIDAD = 1;
            const TIPO_MATRICULA_COMPLETA = 2; // Matrícula Completa
            const TIPO_MATRICULA = 4; // Confirmación de Matrícula
            const TIPO_RIFA = 10;
            const tiposConMeses = [TIPO_MENSUALIDAD, TIPO_RIFA];
            
            // Tipos de movimiento que requieren cargar matrícula
            const tiposMatricula = [TIPO_MATRICULA_COMPLETA, TIPO_MATRICULA];

            function sinDiacriticos(str) {
                return (str || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }

            /** Matrícula por Id o por texto del concepto (por si en BD los Id no son 2/4). */
            function esConceptoMatricula() {
                const val = $tipoMovimiento.val();
                const id = parseInt(val, 10);
                if (!isNaN(id) && id > 0 && tiposMatricula.includes(id)) {
                    return true;
                }
                const texto = sinDiacriticos($tipoMovimiento.find('option:selected').text()).toLowerCase();
                return texto.indexOf('matric') >= 0;
            }

            function actualizarEtiquetaFechaEmision() {
                const $lbl = $('.js-lbl-fecha-emision').first();
                const $ayuda = $('#ayudaFechaMatricula');
                if (!$lbl.length) {
                    return;
                }
                if (esConceptoMatricula()) {
                    $lbl.text('Fecha que se presentó a matricularse');
                    $ayuda.show();
                } else {
                    $lbl.text('Fecha de pago');
                    $ayuda.hide();
                }
            }

            // Función para obtener abonos previos
            function obtenerAbonosPrevios(idAlumno, idTipoMovimiento, periodo, callback) {
                if (!idAlumno || !idTipoMovimiento || !periodo) {
                    console.log('obtenerAbonosPrevios: Faltan parámetros', { idAlumno, idTipoMovimiento, periodo });
                    if (callback) callback(0);
                    return;
                }

                console.log('Obteniendo abonos previos:', { idAlumno, idTipoMovimiento, periodo });

                $.getJSON(urlsPagos.obtenerAbonosPrevios, {
                    idAlumno: idAlumno,
                    idTipoMovimiento: idTipoMovimiento,
                    idPeriodo: periodo
                }, function(data) {
                    console.log('Abonos previos recibidos:', data);
                    const totalAbonos = data && data.totalAbonos ? parseFloat(data.totalAbonos) : 0;
                    if (callback) callback(totalAbonos);
                }).fail(function(xhr, status, error) {
                    console.error('Error al cargar abonos previos:', error, xhr);
                    if (callback) callback(0);
                });
            }

            // Matrícula completa (2): CostoMatricula en catálogo = total a pagar (incluye enero).
            // Desglose: Matrícula neta = Total − mensualidad enero; no se suman dos catálogos.
            // La mensualidad se consulta con la misma regla que Estado de cuenta (recinto + grado + período + modalidad).
            // Confirmación (4): solo costo de matrícula del catálogo (sin desglose enero aquí).
            function cargarMatricula() {
                const recinto = $recinto.val();
                const modalidad = $modalidad.val();
                const periodo = $periodo.val();
                const grado = $grado.val();
                const idAlumno = $idAlumno.val();
                const tipoMovimientoId = parseInt($tipoMovimiento.val()) || 0;
                const idTipoMovimiento = tipoMovimientoId || TIPO_MATRICULA_COMPLETA;

                function aplicarMontoMatricula(costoMatricula, totalAbonos) {
                    const matNeto = Math.max(0, costoMatricula - totalAbonos);
                    if (tipoMovimientoId === TIPO_MATRICULA_COMPLETA) {
                        if (grado) {
                            const idG = parseInt(grado, 10);
                            const idP = parseInt(periodo, 10);
                            const paramsMens = {
                                idRecinto: recinto,
                                idGrado: idG,
                                idPeriodo: idP
                            };
                            const idMod = modalidad ? parseInt(modalidad, 10) : 0;
                            if (idMod > 0) {
                                paramsMens.idModalidad = idMod;
                            }
                            $.getJSON(urlsPagos.obtenerMensualidad, paramsMens, function(dataMen) {
                                const costoMensualidad = parseFloat(dataMen && dataMen.costo) || 0;
                                const parteMatricula = Math.max(0, matNeto - costoMensualidad);
                                $monto.val(matNeto.toFixed(2));
                                // Texto: el total del catálogo (paquete) es matNeto; la parte "solo matrícula" es total − enero.
                                let txt = 'Total matrícula (catálogo) C$ ' + matNeto.toFixed(2) + ': Matrícula neta C$ ' + parteMatricula.toFixed(2) + ' (total − enero) + Mensualidad enero C$ ' + costoMensualidad.toFixed(2) + '.';
                                if (dataMen && dataMen.sinConfiguracion && costoMensualidad === 0) {
                                    txt = 'No hay mensualidad en catálogo para este recinto, nivel, ciclo y modalidad (p. ej. modalidad ' + (idMod || '—') + '): no se puede restar enero al total. Revise Tbl costo mensualidad. Monto a pagar C$ ' + matNeto.toFixed(2) + '.';
                                }
                                if (totalAbonos > 0) {
                                    txt = 'Se descontaron C$ ' + totalAbonos.toFixed(2) + ' de confirmación previa. ' + txt;
                                }
                                $mensajeMontoMatricula.text(txt).css('display', 'block');
                                calcularTotalPagar();
                            }).fail(function() {
                                $monto.val(matNeto.toFixed(2));
                                let txt = 'No se pudo cargar la mensualidad. Monto total C$ ' + matNeto.toFixed(2) + '.';
                                if (totalAbonos > 0) {
                                    txt = 'Abonos previos C$ ' + totalAbonos.toFixed(2) + '. ' + txt;
                                }
                                $mensajeMontoMatricula.text(txt).css('display', 'block');
                                calcularTotalPagar();
                            });
                        } else {
                            $monto.val(matNeto.toFixed(2));
                            let txt = 'Seleccione nivel (grado) para desglosar enero; monto total C$ ' + matNeto.toFixed(2) + '.';
                            if (totalAbonos > 0) {
                                txt = 'Se descontaron C$ ' + totalAbonos.toFixed(2) + ' de confirmación previa. ' + txt;
                            }
                            $mensajeMontoMatricula.text(txt).css('display', 'block');
                            calcularTotalPagar();
                        }
                        return;
                    }
                    $monto.val(matNeto.toFixed(2));
                    if (totalAbonos > 0) {
                        $mensajeMontoMatricula.text('Se le restó C$ ' + totalAbonos.toFixed(2) + ' de abonos previos. Monto: C$ ' + matNeto.toFixed(2)).css('display', 'block');
                    } else {
                        $mensajeMontoMatricula.text('').css('display', 'none');
                    }
                    calcularTotalPagar();
                }

                if (recinto && modalidad && periodo) {
                    $.getJSON(urlsPagos.obtenerMatricula, {
                        idRecinto: recinto,
                        idModalidad: modalidad,
                        idPeriodo: periodo
                    }, function(data) {
                        if (data && data.costo) {
                            const costoMatricula = parseFloat(data.costo) || 0;
                            $mensajeMontoMatricula.text('').css('display', 'none');
                            if (idAlumno) {
                                obtenerAbonosPrevios(idAlumno, idTipoMovimiento, periodo, function(totalAbonos) {
                                    aplicarMontoMatricula(costoMatricula, totalAbonos);
                                });
                            } else {
                                aplicarMontoMatricula(costoMatricula, 0);
                            }
                        }
                    }).fail(function(xhr, status, error) {
                        console.error('Error al cargar matricula:', error, xhr);
                    });
                } else {
                    console.log('Faltan campos requeridos para cargar matrícula:', { recinto, modalidad, periodo });
                }
            }

            let costoMensualidadUnitario = 0;
            let totalAbonosMensualidad = 0;

            function obtenerCantidadMesesSeleccionados() {
                const val = $('#MesesSeleccionados').val();
                if (!val || !String(val).trim()) return 0;
                return String(val).split(',').filter(x => x.trim()).length;
            }

            function recalcularMontoPorMeses() {
                if (parseInt($tipoMovimiento.val(), 10) !== TIPO_MENSUALIDAD) return;

                const cantidadMeses = obtenerCantidadMesesSeleccionados();
                if (costoMensualidadUnitario <= 0) {
                    if (cantidadMeses > 0) {
                        $mensajeMontoMatricula
                            .text('Complete recinto, nivel y ciclo (y alumno si aplica) para obtener la mensualidad.')
                            .css('display', 'block');
                    }
                    return;
                }

                if (cantidadMeses === 0) {
                    $monto.val('');
                    $mensajeMontoMatricula
                        .text('Mensualidad: C$ ' + costoMensualidadUnitario.toFixed(2) + ' por mes. Seleccione los meses a pagar.')
                        .css('display', 'block');
                    calcularTotalPagar();
                    return;
                }

                const subtotal = costoMensualidadUnitario * cantidadMeses;
                const montoFinal = Math.max(0, subtotal - totalAbonosMensualidad);
                $monto.val(montoFinal.toFixed(2));

                let txt = cantidadMeses + ' mes(es) × C$ ' + costoMensualidadUnitario.toFixed(2) + ' = C$ ' + subtotal.toFixed(2);
                if (totalAbonosMensualidad > 0) {
                    txt += '. Abonos previos: −C$ ' + totalAbonosMensualidad.toFixed(2) + '. Total: C$ ' + montoFinal.toFixed(2);
                }
                $mensajeMontoMatricula.text(txt).css('display', 'block');
                calcularTotalPagar();
            }

            // Función para cargar mensualidad
            function cargarMensualidad() {
                const recinto = $recinto.val();
                const grado = $grado.val();
                const periodo = $periodo.val();
                const modalidad = $modalidad.val();
                const idAlumno = $idAlumno.val();
                const idTipoMovimiento = TIPO_MENSUALIDAD; // 1

                console.log('cargarMensualidad llamado', { recinto, grado, periodo, modalidad, idAlumno });

                if (recinto && grado && periodo) {
                    const paramsMens = {
                        idRecinto: recinto,
                        idGrado: grado,
                        idPeriodo: periodo
                    };
                    const idMod = modalidad ? parseInt(modalidad, 10) : 0;
                    if (idMod > 0) {
                        paramsMens.idModalidad = idMod;
                    }

                    $.getJSON(urlsPagos.obtenerMensualidad, paramsMens, function(data) {
                        console.log('Datos de mensualidad recibidos:', data);
                        if (data && data.costo !== undefined) {
                            costoMensualidadUnitario = parseFloat(data.costo) || 0;

                            if (idAlumno) {
                                obtenerAbonosPrevios(idAlumno, idTipoMovimiento, periodo, function(totalAbonos) {
                                    totalAbonosMensualidad = totalAbonos || 0;
                                    recalcularMontoPorMeses();
                                });
                            } else {
                                totalAbonosMensualidad = 0;
                                recalcularMontoPorMeses();
                            }
                        }
                    }).fail(function(xhr, status, error) {
                        console.error('Error al cargar mensualidad:', error, xhr);
                    });
                } else {
                    costoMensualidadUnitario = 0;
                    console.log('Faltan campos requeridos para cargar mensualidad');
                }
            }

            // Función para cargar mora (solo aplica cuando la matrícula del alumno inicia en enero)
            function cargarMora() {
                const idAlumno = $idAlumno.val();
                const idTipoMovimiento = $tipoMovimiento.val();
                const periodo = $periodo.val();

                if (idAlumno && idTipoMovimiento && periodo) {
                    $.getJSON(urlsPagos.obtenerMora, {
                        idAlumno: idAlumno,
                        idTipoMovimiento: idTipoMovimiento,
                        periodo: periodo
                    }, function(data) {
                        if (data && data.aplicaMora === true && data.mora) {
                            $totalMora.val(data.mora);
                            $moraDiv.show();
                        } else {
                            $totalMora.val("0");
                            $moraDiv.hide(); // No aplicar mora si se matriculó en marzo u otro mes (no enero)
                        }
                        calcularTotalPagar(); // Recalcular total después de cargar mora
                    }).fail(function() {
                        $totalMora.val("0");
                        $moraDiv.hide();
                        calcularTotalPagar(); // Recalcular aunque falle
                    });
                } else {
                    $moraDiv.hide();
                }
            }

            // Función para calcular total a pagar (corregida)
            function calcularTotalPagar() {
                const costomensualidad = parseFloat($monto.val()) || 0;
                const costomatricula = parseFloat($monto.val()) || 0;
                const totalmora = parseFloat($totalMora.val()) || 0;
                const tipoMovimientoId = parseInt($tipoMovimiento.val()) || 0;

                if (tipoMovimientoId === TIPO_MENSUALIDAD) {
                    $totalPagar.val((costomensualidad + totalmora).toFixed(2));
                } else if (esConceptoMatricula()) {
                    $totalPagar.val(costomatricula.toFixed(2));
                }
            }

            // Remover todos los listeners relacionados con tipoMovimiento antes de configurar
            function limpiarListeners() {
                $recinto.add($grado).add($periodo).add($modalidad).add($anyo)
                    .off('change.tipoMovimiento');
            }

            // Configurar listeners según el tipo de movimiento
            function configurarListenersPorTipo(tipoId) {
                limpiarListeners(); // Limpiar antes de agregar nuevos
                console.log('Configurando listeners para tipo:', tipoId);

                if (tipoId === TIPO_MENSUALIDAD) {
                    // Mensualidad: recinto + grado + periodo + modalidad → cargar mensualidad
                    $recinto.add($grado).add($periodo).add($modalidad)
                        .on('change.tipoMovimiento', function() {
                            console.log('Cambio detectado en campos de mensualidad');
                            cargarMensualidad();
                        });
                    // Grado → cargar mora
                    $grado.on('change.tipoMovimiento', function() {
                        console.log('Cambio detectado en grado, cargando mora');
                        cargarMora();
                    });
                    // Año → calcular total
                    $anyo.on('change.tipoMovimiento', calcularTotalPagar);
                    
                    // Si ya hay valores, ejecutar inmediatamente
                    if ($recinto.val() && $grado.val() && $periodo.val()) {
                        console.log('Ejecutando cargarMensualidad inmediatamente');
                        cargarMensualidad();
                    }
                } else if (tiposMatricula.includes(tipoId) || esConceptoMatricula()) {
                    // Matrícula: recinto + modalidad + periodo (+ grado si matrícula completa para sumar enero)
                    $recinto.add($modalidad).add($periodo)
                        .on('change.tipoMovimiento', function() {
                            cargarMatricula();
                        });
                    $grado.on('change.tipoMovimiento', function() {
                        if (parseInt($tipoMovimiento.val(), 10) === TIPO_MATRICULA_COMPLETA) {
                            cargarMatricula();
                        }
                    });
                    $anyo.on('change.tipoMovimiento', calcularTotalPagar);

                    if ($recinto.val() && $modalidad.val() && $periodo.val()) {
                        cargarMatricula();
                    }
                }
            }

            // Manejar cambio de tipo de movimiento (optimizado)
            function onTipoMovimientoChange() {
                const tipoMovimientoId = parseInt($tipoMovimiento.val(), 10) || 0;
                const mostrarMeses = tiposConMeses.includes(tipoMovimientoId);

                $mesPagado.toggle(mostrarMeses);

                if (tipoMovimientoId === TIPO_MENSUALIDAD) {
                    configurarListenersPorTipo(TIPO_MENSUALIDAD);
                    cargarMora();
                } else if (tiposMatricula.includes(tipoMovimientoId) || esConceptoMatricula()) {
                    $moraDiv.hide();
                    configurarListenersPorTipo(tipoMovimientoId || TIPO_MATRICULA_COMPLETA);
                } else {
                    $moraDiv.hide();
                    limpiarListeners();
                }

                actualizarEtiquetaFechaEmision();
            }

            $tipoMovimiento.on('change', onTipoMovimientoChange);
            onTipoMovimientoChange();

            // Autocompletado de alumnos
            $alumnoNombre.autocomplete({
                source: function(request, response) {
                    $.ajax({
                        url: urlsPagos.buscarAlumnos,
                        data: { q: request.term },
                        success: function(data) {
                            response($.map(data, function(item) {
                                return {
                                    label: item.nombreCompleto,
                                    value: item.nombreCompleto,
                                    id: item.id
                                };
                            }));
                        },
                        error: function() {
                            response([]);
                        }
                    });
                },
                minLength: 2,
                select: function(event, ui) {
                    $idAlumno.val(ui.item.id);

                    $.getJSON(urlsPagos.obtenerDatosAlumnoMatricula, { idAlumno: ui.item.id })
                        .done(function(data) {
                            if (data && data.ok) {
                                if (data.idRecinto) {
                                    $recinto.val(String(data.idRecinto));
                                }
                                if (data.idModalidad) {
                                    $modalidad.val(String(data.idModalidad));
                                }
                                if (data.idGrado) {
                                    $grado.val(String(data.idGrado));
                                }
                                if (data.idPeriodo) {
                                    $periodo.val(String(data.idPeriodo));
                                }
                            }
                        })
                        .always(function() {
                            const tipoMovimientoId = parseInt($tipoMovimiento.val()) || 0;

                            if (esConceptoMatricula()) {
                                const recinto = $recinto.val();
                                const modalidad = $modalidad.val();
                                const periodo = $periodo.val();
                                if (recinto && modalidad && periodo) {
                                    cargarMatricula();
                                }
                            } else if (tipoMovimientoId === TIPO_MENSUALIDAD) {
                                const recinto = $recinto.val();
                                const grado = $grado.val();
                                const periodo = $periodo.val();
                                if (recinto && grado && periodo) {
                                    cargarMensualidad();
                                    cargarMora();
                                }
                            }
                        });
                }
            });

            
            // Los event listeners ahora se configuran dinámicamente según el tipo de movimiento
            // en la función configurarListenersPorTipo()

            // Función para confirmar meses seleccionados
            window.confirmarMeses = function() {
                const seleccionados = [];
                const nombres = [];

                document.querySelectorAll('#modalMeses input[type="checkbox"]:checked').forEach(chk => {
                    seleccionados.push(chk.value);
                    nombres.push(chk.nextElementSibling.textContent.trim());
                });

                document.getElementById('MesesSeleccionados').value = seleccionados.join(',');

                const contenedor = document.getElementById('mesesSeleccionadosContainer');
                contenedor.innerHTML = '';

                nombres.forEach(nombre => {
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-success me-1 mb-1';
                    badge.textContent = nombre;
                    contenedor.appendChild(badge);
                });

                const modalElement = document.getElementById('modalMeses');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                if (modalInstance) {
                    modalInstance.hide();
                }

                setTimeout(() => {
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('padding-right');
                }, 300);

                recalcularMontoPorMeses();
            };
        });
    </script>

    

    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
                Swal.fire({
                    title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
     TempData["Tipo"]?.ToString() == "warning" ? "Atención" :
     "Información")',
                    text: mensaje,
                    icon: '@TempData["Tipo"]',
                    confirmButtonText: 'Aceptar'
                });
            });
        </script>
    }
}
