@model WebColegio.Models.ViewModel.PagosViewModel

@{
    Layout = null;
    ViewData["Title"] = "Impresión de Recibo";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recibo de Caja - @Model.Pago.NumeroRecibo</title>
    <link rel="stylesheet" href="~/css/voucher-tmu220.css" />
</head>
<body>
    @{
        var recinto = Model.recintos
        .FirstOrDefault(s => s.Value == Model.Pago.IdRecinto.ToString());

    }
    <div class="voucher">

        <!-- Encabezado -->
        <div class="v-header">
            <div class="title">

                @recinto?.Text
            </div>
            @if (recinto?.Text == "COLEGIO PARROQUIAL SAN FRANCISCO JAVIER")
            {
                <div class="sub">VICARIA DE EDUCACIÓN CATÓLICA</div>
                <div class="sub">Ciudad Sandino, Plaza Padre Miguel, 2c. al Norte, Zona #4 Managua</div>
            }
            @if (recinto?.Text == "CENTRO EDUCATIVO PARROQUIAL SAN MIGUEL ARCANGEL")
            {
                <div class="sub">VICARIA DE EDUCACIÓN CATÓLICA</div>
                <div class="sub">Ciudad Sandino, Frente de donde fue la Bomba de la Ruta 172, Zona #11 Managua</div>
            }

        </div>

        <div class="v-section">
            <div class="v-row center bold">@(Model.Pago.IdTipoMovimiento == 2 || Model.Pago.IdTipoMovimiento == 4 ? "RECIBO DE MATRÍCULA" : "RECIBO DE CAJA")</div>
            <div class="v-row">Serie: <span>@Model.Pago.Serie</span></div>
            <div class="v-row">N°: <span>@Model.Pago.NumeroRecibo</span></div>
        </div>

        @{
            var alumno = Model.alumnos?.FirstOrDefault(a => a.IdAlumno == Model.Pago.IdAlumno);
            var grado = Model.grados?.FirstOrDefault(a => a.IdGrado == Model.Pago.IdGrado);
            var tipoMovimiento = Model.tipoMovimiento?.FirstOrDefault(a => a.IdTipoMovimiento == Model.Pago.IdTipoMovimiento);
            var metodopago = Model.metodoPago?.FirstOrDefault(a => a.IdMetodoPago == Model.Pago.IdMetodoPago);
            var esMatricula = Model.Pago.IdTipoMovimiento == 2 || Model.Pago.IdTipoMovimiento == 4;
            var fechaRegistro = Model.Pago.FechaRegistro;
            var fechaEmision = Model.Pago.FechaEmision;
            var fechaPieRecibo = fechaEmision ?? fechaRegistro;
            string FormatearFecha(DateTime? d) => d.HasValue && d.Value != default ? d.Value.ToString("dd/MM/yyyy") : "—";
            string FormatearFechaDt(DateTime d) => d != default ? d.ToString("dd/MM/yyyy") : "—";
            var usuarioCajero = Model.usuariosSelectListItem?
                .FirstOrDefault(u => u.Value == Model.Pago.UsuarioRegistro.ToString())?.Text;
        }

        <div class="v-section">
            <div class="v-row"><b>Recibí de:</b> <span>@alumno?.Nombre @alumno?.Apellido</span></div>
            <div class="v-row"><b>Nivel:</b> <span>@grado?.NombreGrado</span></div>
            <div class="v-row"><b>@(esMatricula ? "Fecha matrícula:" : "Fecha emisión:")</b> <span>@FormatearFecha(fechaEmision)</span></div>
            <div class="v-row"><b>Fecha registro:</b> <span>@FormatearFechaDt(fechaRegistro)</span></div>
            <div class="v-row"><b>Concepto:</b>
                <span>@(tipoMovimiento?.Concepto ?? "—")@(Model.Pago.IdTipoMovimiento == 1 && !string.IsNullOrEmpty(Model.DetalleMesesRecibo) ? " (" + Model.DetalleMesesRecibo + ")" : ""), @(Model.Pago?.Descripcion ?? "")</span>
            </div>
            <div class="v-row"><b>Método Pago:</b> <span>@metodopago?.MetodoPago</span></div>

            <div class="v-row"><b>Monto:</b>
                @if (Model.Pago.IdTipoMovimiento == 2 && Model.MontoTotalRecibo.HasValue && Model.MontoTotalRecibo > 0)
                {
                    <span>C$ @Model.MontoTotalRecibo.Value.ToString("N2")</span>
                }
                else if (Model.Pago.IdTipoMovimiento == 1 && Model.MontoTotalRecibo.HasValue && Model.MontoTotalRecibo > 0)
                {
                    <span>C$ @Model.MontoTotalRecibo.Value.ToString("N2")</span>
                    @if (!string.IsNullOrEmpty(Model.DetalleMesesRecibo))
                    {
                        <span class="v-row" style="font-size: 11px;">(@(Model.DetalleMesesRecibo))</span>
                    }
                }
                else
                {
                    <span>C$ @Model.Pago.Monto.ToString("N2")</span>
                }
            </div>
            @if (Model.Pago.IdTipoMovimiento == 2 && Model.LineasRecibo != null && Model.LineasRecibo.Count > 0)
            {
                foreach (var linea in Model.LineasRecibo)
                {
                    <div class="v-row">@linea.Etiqueta: <span>C$ @linea.Monto.ToString("N2")</span></div>
                }
            }
            @if (Model.Pago.IdTipoMovimiento == 1)
            {
                var montoMensualidad = Model.MontoMensualidadRecibo ?? Model.Pago.Monto;
                var moraRecibo = Model.MoraRecibo ?? 0m;
                var totalPagar = Model.TotalPagarRecibo ?? (montoMensualidad + moraRecibo);
                if (Model.LineasRecibo != null && Model.LineasRecibo.Count > 0)
                {
                    foreach (var linea in Model.LineasRecibo)
                    {
                        <div class="v-row">@linea.Etiqueta: <span>C$ @linea.Monto.ToString("N2")</span></div>
                    }
                }
                else
                {
                    <div class="v-row"><b>Monto mensualidad:</b> <span>C$ @montoMensualidad.ToString("N2")</span></div>
                }
                @if (moraRecibo > 0)
                {
                    <div class="v-row"><b>Monto mora:</b> <span>C$ @moraRecibo.ToString("N2")</span></div>
                }
                <div class="v-row"><b>Total a pagar:</b> <span>C$ @totalPagar.ToString("N2")</span></div>
            }
            <div class="v-row"><b>En letras:</b><br />
                @if (Model.Pago.IdTipoMovimiento == 2 && !string.IsNullOrEmpty(Model.CantidadEnLetrasTotalRecibo))
                {
                    @(Model.CantidadEnLetrasTotalRecibo) @(string.Format("(C$ {0:N2})", Model.MontoTotalRecibo))
                }
                else if (Model.Pago.IdTipoMovimiento == 1 && !string.IsNullOrEmpty(Model.CantidadEnLetrasTotalRecibo))
                {
                    @(Model.CantidadEnLetrasTotalRecibo) @(string.Format("(C$ {0:N2})", Model.MontoTotalRecibo))
                }
                else
                {
                    @(Model.cantidadEnLetras) @(string.Format("(C$ {0:N2})", Model.Pago.Monto))
                }
            </div>
        </div>

        <div class="v-section center">
            Managua: @fechaPieRecibo.Day de
            @System.Globalization.CultureInfo.GetCultureInfo("es-NI").DateTimeFormat.GetMonthName(fechaPieRecibo.Month)
            del @fechaPieRecibo.Year
        </div>

        <!-- Firma -->
        <div class="firma">
            <div class="line"></div>
            <div class="txt">Firma y Sello del Cajero</div>
            <div class="txt">@(usuarioCajero ?? "Cajero")</div>
        </div>

    </div>

    <div class="no-print center">
        <button class="print-button " onclick="window.print()">🖨️ Imprimir</button>
       <a asp-action="Create" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        
    </div>
    
</body>

</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script src="~/js/limpiarcampos.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var tipo = @Html.Raw(Json.Serialize(TempData["Tipo"]?.ToString() ?? "info"));
            var titulo = tipo === 'success' ? 'Éxito' : tipo === 'warning' ? 'Atención' : tipo === 'error' ? 'Error' : 'Información';
            Swal.fire({
                title: titulo,
                text: mensaje,
                icon: tipo,
                confirmButtonText: 'Aceptar'
            });
        });
    </script>
}

