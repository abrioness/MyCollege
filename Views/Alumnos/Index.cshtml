@model WebColegio.Models.ViewModel.ColeccionCatalogos
@* @{
	ViewData["Title"] = "Index";
} *@
@{
	var puedeAnular = User.IsInRole("Admin") || User.IsInRole("UserSystem");
}
<script src="~/js/site.js"></script>
@* <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" /> *@
<div class="container-fluid p-1" style="margin:auto;">
	<div class="card shadow-lg p-3 mb-5 bg-white rounded" style="padding-top:50px;">
		<div class="card-header bg-primary text-white">
			<h5 class="mb-0"><i class="bi bi-people"></i> Reporte de Estudiantes</h5>
		</div>
		<div class="card-body">
			<div class="table-responsive" style="font-size:12px">
				<div class="col-4 text-center">
					@using (Html.BeginForm("Index", "Alumnos", FormMethod.Get))
					{
						<div class="row">
							<div class="col-4">
								<label class="control-label">Desde:</label>
								<input type="date" name="fechainicio" id="FechaInicio" class="form-control"
								value="@Context.Request.Query["fechainicio"]" />
							</div>
							<div class="col-4">
								<label class="control-label">Hasta:</label>
								<input type="date" name="fechafin" id="FechaFin" class="form-control"
								value="@Context.Request.Query["fechafin"]" />
							</div>
							<div class="col-4">
								<br />
								<button type="submit" class="form-control btn btn-success">Filtrar</button>
							</div>
						</div>
					}
				</div>
				<div class="col-12 text-end">

					<a asp-action="Create" class="btn btn-primary">
						<i class="bi bi-plus-circle"></i> Agregar Alumno
					</a>
				</div>
				<br />
				<table id="tablaAlumnos" class="table table-bordered table-sm">
					<thead>
						<tr>
							<th>Código Alumno</th>
							<th>Código MINED</th>
							<th>Nombre</th>
							<th>Apellido</th>
							<th>Edad</th>
							@* <th>Cedula</th> *@
							<th>Grado</th>
							<th>Turno</th> 
							<th>Sexo</th>
							<th>Colegio</th>
							<th>Fecha Registro</th>
							<th>Estado</th>
							<th>Acciones</th>
						</tr>
					</thead>
					<tbody>
						@foreach(var itemAlumno in Model.alumno){
							var grado = Model.grados?.FirstOrDefault(a => a.IdGrado == itemAlumno.IdGrado);
							var turno = Model.turnos?.FirstOrDefault(a => a.IdTurno == itemAlumno.IdTurno);
							var sexo = Model.sexos?.FirstOrDefault(a => a.IdSexo == itemAlumno.IdSexo);
							var recinto = Model.recintos?.FirstOrDefault(a => a.IdRecinto == itemAlumno.IdRecinto);
							var nombreAlumno = $"{itemAlumno.Nombre} {itemAlumno.Apellido}".Trim();
							<tr class="@(itemAlumno.Activo == true ? "" : "table-secondary")">
								<td data-order="@itemAlumno.IdAlumno">
									<a asp-action="Edit" asp-controller="Alumnos" asp-route-id="@itemAlumno.IdAlumno" class="btn btn-sm btn-info">	@itemAlumno.CodigoAlumno</a>
								</td>
								<td>
									@itemAlumno.CodigoMINED
								</td>
								<td>
									@itemAlumno.Nombre
								</td>
								<td>
									@itemAlumno.Apellido
								</td>
								<td>
									@itemAlumno.Edad
								</td>
								<td>
									@(grado?.NombreGrado ?? "—")
								</td>
								<td>
									@(turno?.NombreTurno ?? "—")
								</td>
								<td>
									@(sexo?.Sexo ?? "—")
								</td>
								<td>
									@(recinto?.Recinto ?? "—")
								</td>
								<td>
									@itemAlumno.FechaRegistro.ToString("dd/MM/yyyy")
								</td>
								@if (itemAlumno.Activo == true)
								{
									<td>
										<span class="badge bg-success">Activo</span>
									</td>
								}
								else
								{
									<td><span class="badge bg-secondary">Anulado</span></td>
								}
								<td>
									@if (itemAlumno.Activo == true)
									{
										<a asp-controller="Matriculas" asp-action="Create" asp-route-idAlumno="@itemAlumno.IdAlumno" class="btn btn-sm btn-outline-primary" title="Rematricular">
											<i class="bi bi-journal-plus"></i> Rematricular
										</a>
										@if (puedeAnular)
										{
											<form asp-action="Anular" asp-controller="Alumnos" method="post" class="d-inline js-anular-recibo"
												  data-mensaje="¿Anular el registro de @nombreAlumno?">
												@Html.AntiForgeryToken()
												<input type="hidden" name="id" value="@itemAlumno.IdAlumno" />
												<input type="hidden" name="fechainicio" value="@Context.Request.Query["fechainicio"]" />
												<input type="hidden" name="fechafin" value="@Context.Request.Query["fechafin"]" />
												<button type="submit" class="btn btn-sm btn-outline-danger" title="Anular estudiante">
													<i class="bi bi-x-circle"></i> Anular
												</button>
											</form>
										}
									}
									else
									{
										<span class="text-muted small">—</span>
									}
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
		</div>
	</div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
	$(document).on("submit", "form.js-anular-recibo", function (e) {
		e.preventDefault();
		var form = this;
		var mensaje = form.getAttribute("data-mensaje") || "¿Anular el registro?";
		if (typeof Swal === "undefined") {
			if (window.confirm(mensaje)) form.submit();
			return;
		}
		Swal.fire({
			title: "Atención",
			text: mensaje,
			icon: "warning",
			showCancelButton: true,
			confirmButtonText: "Aceptar",
			cancelButtonText: "Cancelar"
		}).then(function (result) {
			if (result.isConfirmed) form.submit();
		});
	});
	$(document).ready(function () {
		var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");
		var botones = esCajero ? [] : [
			{
				extend: 'excelHtml5',
				text: 'Exportar a Excel',
				className: 'btn btn-success'
			}
		];
		$('#tablaAlumnos').DataTable({
			responsive: false,
			pageLength: 10,
			lengthMenu: [[5, 10, 20], [5, 10, 20]],
			paging: true,
			order: [[0, 'desc']],
			dom: esCajero ? 'lfrtip' : 'Blfrtip',
			buttons: botones,
			language: {
				url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
			}
		});
	});
</script>
@if (TempData["Mensaje"] != null)
{
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
			var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
			Swal.fire({
				title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
				text: mensaje,
				icon: tipo,
				confirmButtonText: "Aceptar"
			});
		});
	</script>
}

