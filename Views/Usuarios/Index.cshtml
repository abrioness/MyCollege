@model WebColegio.Models.ViewModel.UsuarioViewModel

@{
    ViewData["Title"] = "Index";
}



@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"> <i class="bi bi-card-checklist"></i> Reporte de Usuarios </h4>
        </div>@* <br />
         <div>
                    <a id="btnNuevo" class="btn btn-primary float-end" href="@Url.Action("Create", "Contenidos")"> <i class="bi bi-plus-circle"></i>Nuevo </a>
                </div> *@
        <div class="card-body">
            <table id="tablaUsuarios" class="table table-bordered table-striped display " style="width:100%">
                <thead>
                    <tr>
                        @* <th>
                @Model.IdUsuario)
            </th> *@
                        <th>
                            Nombre de Usuario
                        </th>
                        <th>
                            
                            Nombre Completo
                        </th>
                        <th>
                            Colegio
                        </th>
                        <th>
                            Cedula
                        </th>
                        <th>
                            Correo
                        </th>
                        <th>
                            Rol
                        </th>
                        <th>
                            Estado
                        </th>


                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListaUsuarios) {
                        {
                            var rol = Model.ListRol.FirstOrDefault(a=>a.IdRol==item.IdRol);
                        
                        
                            @if (@rol?.NombreRol != "UserSystem")
                            {
                                
                       
        <tr>
            <td>
                 <a asp-action="Edit" asp-controller="Usuarios" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-info">@item.NombreUsuario</a>
            </td>

            <td>
                                 @item.NombreCompleto
                                
            </td>

                            @{
                                var colegio = Model.ListRecintos.
                                FirstOrDefault(a => a.IdRecinto == item.IdRecinto);
                            }
                            <td>
                                @(string.IsNullOrEmpty(colegio?.Recinto)
                                    ? "Sin Datos"
                                    : colegio.Recinto)

                            </td>
                            <td>
                                @item.Cedula
                            </td>
            <td>
                                @item.Correo
            </td>
           
            
            <td>
                @rol?.NombreRol
            </td>
            <td>
                                @if ((item.Activo == true))
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
            </td>
            @* <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>  *@
        </tr>
                            }
                        }
}
    </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script>
        $(document).ready(function () {
        var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");
        var botones = esCajero ? [] : [
            {
            extend: 'excelHtml5',
            text: 'Exportar a Excel',
            className: 'btn btn-success'
            }
        ];
        $('#tablaUsuarios').DataTable({
        responsive: false,
        dom: esCajero ? 'frtip' : 'Bfrtip', // Sin botones para Cajero
        buttons: botones,
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
            }
        });
    });
</script>

<script src="~/seewtalert/sweetalert.all.min.js"></script>
<link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
            Swal.fire({
                title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
                text: mensaje,
                icon: tipo,
                confirmButtonText: "Aceptar"
            });
        });
    </script>
}