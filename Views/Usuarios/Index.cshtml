@model WebColegio.Models.ViewModel.UsuarioViewModel
@using WebColegio.Helpers
@using WebColegio.Models

@{
    ViewData["Title"] = "Index";
}



@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<style>
    .usuarios-lista {
        max-width: 100%;
    }
    .usuarios-lista .card-body {
        overflow-x: auto;
    }
    .usuarios-lista .dataTables_wrapper {
        width: 100%;
    }
    .usuarios-lista table.dataTable thead th,
    .usuarios-lista table.dataTable tbody td {
        white-space: nowrap;
        vertical-align: middle;
    }
</style>
<div class="container-fluid mt-3 px-3 usuarios-lista">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"> <i class="bi bi-card-checklist"></i> Reporte de Usuarios </h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
            <table id="tablaUsuarios" class="table table-bordered table-striped table-sm w-100">
                <thead>
                    <tr>
                        @* <th>
                @Model.IdUsuario)
            </th> *@
                        <th>
                            Nombre de Usuario
                        </th>
                        <th>
                            
                            Nombre Completo
                        </th>
                        <th>
                            Colegio
                        </th>
                        <th>
                            Cedula
                        </th>
                        <th>
                            Correo
                        </th>
                        <th>
                            Rol
                        </th>
                        <th>
                            Código del alumno
                        </th>
                        <th>
                            Nombre del alumno
                        </th>
                        <th>
                            Grado asociado
                        </th>
                        <th>
                            Fecha de creación
                        </th>
                        <th>
                            Estado
                        </th>
                        @if (User.IsInRole("Admin") || User.IsInRole("UserSystem"))
                        {
                            <th class="no-export">Acciones</th>
                        }


                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListaUsuarios) {
                        {
                            var rol = Model.ListRol.FirstOrDefault(a=>a.IdRol==item.IdRol);
                        
                        
                            @if (@rol?.NombreRol != "UserSystem")
                            {
                                
                       
        <tr>
            <td>
                 <a asp-action="Edit" asp-controller="Usuarios" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-info">@item.NombreUsuario</a>
            </td>

            <td>
                                 @item.NombreCompleto
                                
            </td>

                            @{
                                var colegio = Model.ListRecintos.
                                FirstOrDefault(a => a.IdRecinto == item.IdRecinto);
                            }
                            <td>
                                @(string.IsNullOrEmpty(colegio?.Recinto)
                                    ? "Sin Datos"
                                    : colegio.Recinto)

                            </td>
                            <td>
                                @item.Cedula
                            </td>
            <td>
                                @item.Correo
            </td>
           
            
            <td>
                @rol?.NombreRol
            </td>
            @{
                var esTutor = TutorAlumnoVinculo.EsRolTutor(rol?.NombreRol, item.IdRol);
                var alumnosTutor = esTutor
                    ? TutorAlumnoVinculo.AlumnosDeTutor(Model.ListaAlumnos, item.Cedula)
                    : Array.Empty<TblAlumno>();
                var codigoAlumno = TutorAlumnoVinculo.TextoOGuion(alumnosTutor.Select(a =>
                    !string.IsNullOrWhiteSpace(a.CodigoAlumno) ? a.CodigoAlumno : a.CodigoMINED));
                var nombreAlumno = TutorAlumnoVinculo.TextoOGuion(alumnosTutor.Select(a =>
                    $"{a.Nombre} {a.Apellido}".Trim()));
                var gradoAlumno = TutorAlumnoVinculo.TextoOGuion(alumnosTutor.Select(a =>
                    Model.ListGrados.FirstOrDefault(g => g.IdGrado == a.IdGrado)?.NombreGrado));
            }
            <td>@codigoAlumno</td>
            <td>@nombreAlumno</td>
            <td>@gradoAlumno</td>
            <td data-order="@(item.FechaRegistro == default ? "" : item.FechaRegistro.ToString("yyyy-MM-dd"))">
                @(item.FechaRegistro == default ? "—" : item.FechaRegistro.ToString("dd/MM/yyyy"))
            </td>
            <td>
                                @if ((item.Activo == true))
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
            </td>
            @if (User.IsInRole("Admin") || User.IsInRole("UserSystem"))
            {
                <td>
                    @{
                        var idSesion = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    }
                    @if (idSesion != item.IdUsuario.ToString())
                    {
                        <form asp-action="Eliminar" asp-controller="Usuarios" method="post" class="d-inline js-eliminar-usuario"
                              data-mensaje="¿Eliminar de forma permanente la cuenta de @item.NombreUsuario? Esta acción no se puede deshacer.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.IdUsuario" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar cuenta">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            }
        </tr>
                            }
                        }
}
    </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
        $(document).on("submit", "form.js-eliminar-usuario", function (e) {
            e.preventDefault();
            var form = this;
            var mensaje = form.getAttribute("data-mensaje") || "¿Eliminar la cuenta de forma permanente?";
            if (typeof Swal === "undefined") {
                if (window.confirm(mensaje)) form.submit();
                return;
            }
            Swal.fire({
                title: "Atención",
                text: mensaje,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Eliminar",
                cancelButtonText: "Cancelar"
            }).then(function (result) {
                if (result.isConfirmed) form.submit();
            });
        });
        $(document).ready(function () {
        var esCajero = @(User.IsInRole("Cajero") ? "true" : "false");
        var botones = esCajero ? [] : [
            {
            extend: 'excelHtml5',
            text: 'Exportar a Excel',
            className: 'btn btn-success',
            exportOptions: { columns: ':not(.no-export)' }
            }
        ];
        var colAcciones = $('#tablaUsuarios thead th.no-export').index();
        $('#tablaUsuarios').DataTable({
        responsive: false,
        autoWidth: false,
        pageLength: 10,
        lengthMenu: [[5, 10, 20], [5, 10, 20]],
        paging: true,
        dom: esCajero ? 'lfrtip' : 'Blfrtip',
        buttons: botones,
        columnDefs: colAcciones >= 0 ? [{ orderable: false, targets: colAcciones }] : [],
            language: window.datatablesEspanol
        });
    });
</script>

<script src="~/seewtalert/sweetalert.all.min.js"></script>
<link href="~/seewtalert/sweetalert.min.css" rel="stylesheet" />
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var tipo = '@(TempData["Tipo"]?.ToString() ?? "info")';
            Swal.fire({
                title: tipo === "success" ? "Éxito" : tipo === "warning" ? "Atención" : tipo === "error" ? "Error" : "Información",
                text: mensaje,
                icon: tipo,
                confirmButtonText: "Aceptar"
            });
        });
    </script>
}