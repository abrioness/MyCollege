@model WebColegio.Models.ViewModel.MatriculaListaViewModel
@{
    ViewData["Title"] = "Matrículas";
    string NombreAlumno(int id)
    {
        var a = Model.Alumnos.FirstOrDefault(x => x.IdAlumno == id);
        return a == null ? id.ToString() : $"{a.Nombre} {a.Apellido}".Trim();
    }
    string Grado(int id) => Model.Grados.FirstOrDefault(g => g.IdGrado == id)?.NombreGrado ?? id.ToString();
    string Modalidad(int id) => Model.Modalidades.FirstOrDefault(m => m.IdModalidad == id)?.Modalidad ?? id.ToString();
    string Recinto(int id) => Model.Recintos.FirstOrDefault(r => r.IdRecinto == id)?.Recinto ?? id.ToString();
    string Periodo(int id) => Model.Periodos.FirstOrDefault(p => p.IdPeriodo == id)?.Periodo.ToString() ?? id.ToString();
}

<style>
    .matriculas-toolbar .btn {
        border-radius: 0.5rem;
        font-weight: 500;
        padding: 0.45rem 0.95rem;
    }
    .matriculas-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }
    .matriculas-acciones .btn {
        font-weight: 500;
        white-space: nowrap;
    }
</style>
<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-journal-check"></i> Matrícula académica por ciclo</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Un estudiante se registra una sola vez en <strong>Alumnos</strong>.
                Aquí se inscribe o rematricula cada año (grado, modalidad, colegio y estado).
                @if (Model.PeriodoMatriculaSugerido != null)
                {
                    <span>Ciclo sugerido para matrícula: <strong>@Model.PeriodoMatriculaSugerido.Periodo</strong>.</span>
                }
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorApi))
            {
                <div class="alert alert-warning">@Model.ErrorApi</div>
            }

            <div class="matriculas-toolbar d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                <form asp-action="Index" method="get" class="row g-2 align-items-end flex-grow-1">
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label mb-1">Ciclo</label>
                        <select name="idPeriodo" class="form-select" onchange="this.form.submit()">
                            @if (Model.IdPeriodoFiltro == null)
                            {
                                <option value="0" selected>Todos los ciclos</option>
                            }
                            else
                            {
                                <option value="0">Todos los ciclos</option>
                            }
                            @foreach (var p in Model.Periodos)
                            {
                                if (Model.IdPeriodoFiltro == p.IdPeriodo)
                                {
                                    <option value="@p.IdPeriodo" selected>@p.Periodo @(p.Actual ? "(actual)" : "")</option>
                                }
                                else
                                {
                                    <option value="@p.IdPeriodo">@p.Periodo @(p.Actual ? "(actual)" : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label mb-1">Estado</label>
                        <select name="estado" class="form-select" onchange="this.form.submit()">
                            <option value="">Todos</option>
                            @foreach (var e in new[] { "Reserva", "Inscrito", "Activo", "Retirado" })
                            {
                                if (string.Equals(Model.EstadoFiltro, e, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@e" selected>@e</option>
                                }
                                else
                                {
                                    <option value="@e">@e</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-12 col-lg-6">
                        <label class="form-label mb-1" for="buscarAlumnoMatricula">Buscar alumno</label>
                        <div class="input-group">
                            <input type="text" name="q" id="buscarAlumnoMatricula" value="@Model.TextoBusqueda"
                                   class="form-control" placeholder="Nombre o apellido" />
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                </form>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Pagos" asp-action="Traslado" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left-right"></i> Traslado
                    </a>
                    <a asp-action="Create" asp-route-idPeriodo="@Model.IdPeriodoFiltro" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> Matricular / rematricular
                    </a>
                    <a asp-controller="Alumnos" asp-action="Create" class="btn btn-outline-secondary">
                        <i class="bi bi-person-plus"></i> Nuevo estudiante
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Alumno</th>
                            <th>Ciclo</th>
                            <th>Nivel</th>
                            <th>Modalidad</th>
                            <th>Colegio</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Matriculas.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    @if (!string.IsNullOrWhiteSpace(Model.ErrorApi))
                                    {
                                        <span>La API no devolvió matrículas. Publique Api_Colegio y ejecute <code>docs/crear-tbl-matricula.sql</code> en MyCollege.</span>
                                    }
                                    else
                                    {
                                        <span>
                                            No hay filas en <strong>Tbl_Matricula</strong>
                                            @(Model.IdPeriodoFiltro == null ? " (ningún ciclo)." : " para este ciclo.")
                                            Los estudiantes de <strong>Alumnos</strong> no aparecen aquí hasta copiarlos con el script SQL o usar “Matricular / rematricular”.
                                            Pruebe <strong>Todos los ciclos</strong>.
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Matriculas)
                        {
                            <tr>
                                <td>@NombreAlumno(item.IdAlumno)</td>
                                <td>@Periodo(item.IdPeriodo)</td>
                                <td>@Grado(item.IdGrado)</td>
                                <td>@Modalidad(item.IdModalidad)</td>
                                <td>@Recinto(item.IdRecinto)</td>
                                <td>
                                    @if (item.Estado == "Activo" || item.Estado == "Inscrito")
                                    {
                                        <span class="badge bg-success">@item.Estado</span>
                                    }
                                    else if (item.Estado == "Reserva")
                                    {
                                        <span class="badge bg-info text-dark">@item.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Estado</span>
                                    }
                                </td>
                                <td>@(item.FechaMatricula?.ToString("dd/MM/yyyy") ?? item.FechaRegistro.ToString("dd/MM/yyyy"))</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm matriculas-acciones" role="group" aria-label="Acciones">
                                        <a asp-action="Edit" asp-route-id="@item.IdMatricula" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-action="Imprimir" asp-route-id="@item.IdMatricula" class="btn btn-outline-success" title="Imprimir hoja de matrícula" target="_blank">
                                            <i class="bi bi-printer"></i> Imprimir
                                        </a>
                                        @if (item.Estado == "Activo" || item.Estado == "Inscrito")
                                        {
                                            <a asp-controller="Pagos" asp-action="Traslado" asp-route-idAlumno="@item.IdAlumno" class="btn btn-outline-secondary" title="Traslado">
                                                <i class="bi bi-arrow-left-right"></i> Traslado
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            Swal.fire({
                title: '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
                    TempData["Tipo"]?.ToString() == "warning" ? "Atención" : "Información")',
                text: mensaje,
                icon: '@(TempData["Tipo"]?.ToString() ?? "info")',
                confirmButtonText: 'Aceptar'
            });
        });
    </script>
}
