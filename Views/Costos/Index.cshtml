@model WebColegio.Models.ViewModel.CostosAdminViewModel
@{
    ViewData["Title"] = "Tarifas y ciclo";
    string NombreRecinto(int id) => Model.Recintos.FirstOrDefault(r => r.IdRecinto == id)?.Recinto ?? id.ToString();
    string NombreModalidad(int id) => id == 0 ? "Todas" : (Model.Modalidades.FirstOrDefault(m => m.IdModalidad == id)?.Modalidad ?? id.ToString());
    string NombreGrado(int id) => Model.Grados.FirstOrDefault(g => g.IdGrado == id)?.NombreGrado ?? id.ToString();
    string NombrePeriodo(int id) => Model.Periodos.FirstOrDefault(p => p.IdPeriodo == id)?.Periodo.ToString() ?? id.ToString();
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-calendar2-check"></i> Ciclo lectivo y matrícula</h4>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                El ciclo <strong>actual</strong> se usa para mensualidades. La matrícula del siguiente ciclo se abre en
                <strong>octubre</strong> sin cambiar el ciclo vigente, para no mezclar cobros de octubre–diciembre.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.AvisoCiclo))
            {
                <div class="alert alert-info">@Model.AvisoCiclo</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Ciclo actual (mensualidades)</div>
                        <div class="fs-4 fw-bold">@(Model.PeriodoActual?.Periodo.ToString() ?? "—")</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100 @(Model.VentanaMatriculaSiguienteCiclo ? "border-success" : "")">
                        <div class="text-muted small">Siguiente ciclo (matrícula desde octubre)</div>
                        <div class="fs-4 fw-bold">@Model.AnioCicloSiguiente</div>
                        <div class="small">
                            @(Model.PeriodoSiguienteExiste ? "Creado" : "Aún no creado")
                            @if (Model.VentanaMatriculaSiguienteCiclo)
                            {
                                <span class="badge bg-success">Ventana de matrícula abierta</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Tarifas del siguiente ciclo</div>
                        <div>Matrícula: <strong>@Model.CantidadCostosMatriculaSiguiente</strong></div>
                        <div>Mensualidad: <strong>@Model.CantidadCostosMensualidadSiguiente</strong></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <form asp-action="HabilitarSiguienteCiclo" method="post" class="d-inline"
                      onsubmit="return confirmarHabilitarCiclo(this);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="copiarTarifas" value="true" />
                    <button type="submit" class="btn btn-success" id="btnHabilitarCiclo">
                        <i class="bi bi-plus-circle"></i>
                        @(Model.PeriodoSiguienteExiste
                            ? $"Copiar tarifas faltantes al ciclo {Model.AnioCicloSiguiente}"
                            : $"Habilitar ciclo {Model.AnioCicloSiguiente} y copiar tarifas")
                    </button>
                </form>
                @if (Model.PeriodoSiguiente != null && Model.PeriodoSiguiente.Actual == false)
                {
                    <form asp-action="ActivarCiclo" method="post" class="d-inline"
                          onsubmit="return confirm('¿Marcar @Model.AnioCicloSiguiente como ciclo actual? Las mensualidades pasarán a ese año. Hágalo cuando cierre el ciclo vigente (habitualmente en enero).');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idPeriodo" value="@Model.PeriodoSiguiente.IdPeriodo" />
                        <button type="submit" class="btn btn-outline-primary">
                            Marcar @Model.AnioCicloSiguiente como actual
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-cash-coin"></i> Valor de matrícula</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Filtrar por ciclo</label>
                    <select name="idPeriodo" class="form-select" onchange="this.form.submit()">
                        @foreach (var p in Model.Periodos)
                        {
                            @if (Model.IdPeriodoFiltro == p.IdPeriodo)
                            {
                                <option value="@p.IdPeriodo" selected>@p.Periodo @(p.Actual ? "(actual)" : "")</option>
                            }
                            else
                            {
                                <option value="@p.IdPeriodo">@p.Periodo @(p.Actual ? "(actual)" : "")</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-8 text-end">
                    <a asp-action="CreateMatricula" asp-route-idPeriodo="@Model.IdPeriodoFiltro" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Agregar matrícula
                    </a>
                    <a asp-action="CreateMensualidad" asp-route-idPeriodo="@Model.IdPeriodoFiltro" class="btn btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Agregar mensualidad
                    </a>
                </div>
            </form>
            <p class="small text-muted">
                El valor de catálogo de matrícula es el total a pagar en matrícula completa (incluye enero).
                La confirmación de matrícula usa el mismo valor como tope de reserva, sin cobrar enero.
            </p>
            <div class="table-responsive">
                <table class="table table-bordered table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Ciclo</th>
                            <th>Colegio</th>
                            <th>Modalidad</th>
                            <th class="text-end">Valor (C$)</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.CostosMatricula.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">No hay tarifas de matrícula para este ciclo.</td></tr>
                        }
                        @foreach (var item in Model.CostosMatricula)
                        {
                            <tr>
                                <td>@NombrePeriodo(item.IdPeriodo)</td>
                                <td>@NombreRecinto(item.IdRecinto)</td>
                                <td>@NombreModalidad(item.IdModalidad)</td>
                                <td class="text-end">@item.CostoMatricula.ToString("N2")</td>
                                <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                                <td>
                                    <a asp-action="EditMatricula" asp-route-id="@item.IdCostoMatricula" class="btn btn-sm btn-info">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-month"></i> Valor de mensualidad</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Ciclo</th>
                            <th>Colegio</th>
                            <th>Nivel</th>
                            <th>Modalidad</th>
                            <th class="text-end">Valor (C$)</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.CostosMensualidad.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted">No hay tarifas de mensualidad para este ciclo.</td></tr>
                        }
                        @foreach (var item in Model.CostosMensualidad)
                        {
                            <tr>
                                <td>@NombrePeriodo(item.IdPeriodo)</td>
                                <td>@NombreRecinto(item.IdRecinto)</td>
                                <td>@NombreGrado(item.IdGrado)</td>
                                <td>@NombreModalidad(item.IdModalidad)</td>
                                <td class="text-end">@item.CostoMensualidad.ToString("N2")</td>
                                <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                                <td>
                                    <a asp-action="EditMensualidad" asp-route-id="@item.IdMensualidad" class="btn btn-sm btn-info">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmarHabilitarCiclo(form) {
        var anio = @Model.AnioCicloSiguiente;
        var yaExiste = @(Model.PeriodoSiguienteExiste ? "true" : "false");
        var texto = yaExiste
            ? 'Se copiarán al ciclo ' + anio + ' las tarifas del ciclo actual que aún no existan. No se marcará como ciclo vigente.'
            : 'Se creará el ciclo ' + anio + ' y se copiarán las tarifas del ciclo actual. No se marcará como ciclo vigente (las mensualidades siguen en el año en curso).';
        if (!confirm(texto))
            return false;
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.innerText = 'Procesando…';
        }
        return true;
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
            var titulo = '@(TempData["Tipo"]?.ToString() == "success" ? "Éxito" :
                TempData["Tipo"]?.ToString() == "warning" ? "Atención" : "Información")';
            var icono = '@(TempData["Tipo"]?.ToString() ?? "info")';
            if (typeof Swal !== 'undefined' && Swal.fire) {
                Swal.fire({
                    title: titulo,
                    text: mensaje,
                    icon: icono,
                    confirmButtonText: 'Aceptar'
                });
            } else {
                alert(titulo + ': ' + mensaje);
            }
        });
    </script>
}
