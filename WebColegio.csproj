<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- IIS Express evita el .exe local que bloquea Smart App Control -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <LaunchProfileName>IIS Express</LaunchProfileName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\Models\**" />
    <Compile Remove="Pages\**" />
    <Compile Remove="Views\ReciboCaja\**" />
    <Content Remove="Models\Models\**" />
    <Content Remove="Pages\**" />
    <Content Remove="Views\ReciboCaja\**" />
    <EmbeddedResource Remove="Models\Models\**" />
    <EmbeddedResource Remove="Pages\**" />
    <EmbeddedResource Remove="Views\ReciboCaja\**" />
    <None Remove="Models\Models\**" />
    <None Remove="Pages\**" />
    <None Remove="Views\ReciboCaja\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="datatables.net" Version="2.3.2" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="jquery.datatables" Version="1.10.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config" CopyToPublishDirectory="Never" />
    <Content Include="logs\.gitkeep" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- El web.config de IIS (JWT y URL de la API) no debe reemplazarse al publicar. -->
  <Target Name="ExcludeWebConfigFromPublishOutput" AfterTargets="Publish">
    <Delete Files="$(PublishDir)web.config" Condition="Exists('$(PublishDir)web.config')" />
  </Target>

</Project>
